<!-- 视频播放器弹窗（可复用组件） -->
<script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>

<div class="modal fade" id="videoPlayerModal" tabindex="-1" data-bs-backdrop="static">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content bg-dark">
      <div class="modal-header border-secondary">
        <h6 class="modal-title text-white text-truncate" id="videoPlayerTitle">视频预览</h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-0 d-flex justify-content-center">
        <video id="videoPlayer" class="w-100" controls autoplay muted style="max-height: 80vh;">
          <p class="text-white p-3">你的浏览器不支持视频播放</p>
        </video>
      </div>
    </div>
  </div>
</div>

<script>
let flvPlayer = null;
let hlsPlayer = null;

function openVideoPlayer(src, title, ext) {
  const modal = document.getElementById('videoPlayerModal');
  const video = document.getElementById('videoPlayer');
  const titleEl = document.getElementById('videoPlayerTitle');
  if (title) titleEl.textContent = title;

  if (flvPlayer) {
    flvPlayer.destroy();
    flvPlayer = null;
  }
  if (hlsPlayer) {
    hlsPlayer.destroy();
    hlsPlayer = null;
  }
  video.src = '';
  video.style.display = '';

  if (ext === 'm3u8') {
    if (Hls.isSupported()) {
      hlsPlayer = new Hls();
      hlsPlayer.loadSource(src);
      hlsPlayer.attachMedia(video);
      hlsPlayer.on(Hls.Events.MANIFEST_PARSED, () => {
        video.play().catch(function (e) {
          if (e.name !== 'AbortError') console.error('[hls.js] play error:', e);
        });
      });
      hlsPlayer.on(Hls.Events.ERROR, (event, data) => {
        console.error('[hls.js] Error:', data.fatal, data.type, data.details);
        if (data.fatal) {
          switch (data.type) {
            case Hls.ErrorTypes.NETWORK_ERROR:
              hlsPlayer.startLoad();
              break;
            case Hls.ErrorTypes.MEDIA_ERROR:
              hlsPlayer.recoverMediaError();
              break;
            default:
              hlsPlayer.destroy();
              hlsPlayer = null;
              break;
          }
        }
      });
    } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
      video.src = src;
      video.addEventListener('loadedmetadata', () => {
        video.play().catch(function (e) {
          if (e.name !== 'AbortError') console.error('[hls.js] play error:', e);
        });
      });
    }
  } else if ((ext === 'flv') && typeof flvjs !== 'undefined' && flvjs.isSupported()) {
    flvPlayer = flvjs.createPlayer({
      type: 'flv', url: src, isLive: false,
      lazyLoad: false,
      enableStashBuffer: false,
      seekType: 'range',
    });
    flvPlayer.on(flvjs.Events.ERROR, (errType, errDetail) => {
      console.error('[flv.js]', errType, errDetail);
    });
    flvPlayer.attachMediaElement(video);
    flvPlayer.load();
    flvPlayer.play().catch(function (e) {
      if (e.name !== 'AbortError') console.error('[flv.js] play error:', e);
    });
  } else {
    video.src = src;
    video.load();
  }

  const bsModal = new bootstrap.Modal(modal);
  bsModal.show();
  modal.addEventListener('hidden.bs.modal', function stopVideo() {
    video.pause();
    video.src = '';
    if (flvPlayer) {
      flvPlayer.destroy();
      flvPlayer = null;
    }
    if (hlsPlayer) {
      hlsPlayer.destroy();
      hlsPlayer = null;
    }
    modal.removeEventListener('hidden.bs.modal', stopVideo);
  }, { once: true });
}
</script>
