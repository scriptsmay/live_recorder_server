<% if (rooms.length === 0) { %>
<p class="text-muted text-center" id="emptyMsg">暂无直播间数据</p>
<% } else { %>
<table class="table table-hover align-middle" id="roomsTable">
  <thead class="table-light">
    <tr>
      <th>ID</th>
      <th>名称</th>
      <th>直播间地址</th>
      <th>状态</th>
      <th>通知</th>
      <th>监听</th>
      <th>文件名模板</th>
      <th>分段时间</th>
      <th>操作</th>
    </tr>
  </thead>
  <tbody>
    <% rooms.forEach(r => { %>
    <tr>
      <td><%= r.id %></td>
      <td><%= r.room_name || '-' %></td>
      <td><a href="<%= r.room_url %>" target="_blank" title="<%= r.room_url %>"><%= r.room_url %></a></td>
      <td>
        <% if (r.status === 'idle') { %><span class="badge bg-secondary">空闲</span><% } %>
        <% if (r.status === 'recording') { %><span class="badge bg-success">录制中</span><% } %>
        <% if (r.status === 'paused') { %><span class="badge bg-warning text-dark">已暂停</span><% } %>
      </td>
      <td><% if (r.notification_enabled !== false) { %><span class="badge bg-info text-dark">开</span><% } else { %><span class="badge bg-secondary">关</span><% } %></td>
      <td><% if (r.monitoring_enabled !== false) { %><span class="badge bg-info text-dark">开</span><% } else { %><span class="badge bg-secondary">关</span><% } %></td>
      <td><code><%= r.filename_template || '{room_name}_{datetime}' %></code></td>
      <td><% const seg = r.segment_duration; %><%= seg ? (seg >= 3600 ? Math.round(seg/3600)+'h' : seg+'s') : '-' %></td>
      <td class="text-nowrap">
        <% if (r.status === 'idle') { %>
          <button class="btn btn-sm btn-outline-primary editBtn" data-id="<%= r.id %>">编辑</button>
          <button class="btn btn-sm btn-outline-danger" hx-delete="/api/rooms/<%= r.id %>" hx-target="#roomsBody" hx-swap="innerHTML" hx-confirm="确定删除此直播间？" hx-trigger="click">删除</button>
        <% } %>
        <% if (r.status === 'recording') { %>
          <button class="btn btn-sm btn-outline-warning" hx-post="/api/rooms/<%= r.id %>/pause" hx-target="#roomsBody" hx-swap="innerHTML" hx-trigger="click">暂停</button>
          <button class="btn btn-sm btn-outline-danger" hx-post="/api/rooms/<%= r.id %>/stop" hx-target="#roomsBody" hx-swap="innerHTML" hx-confirm="确定停止录制？" hx-trigger="click">停止</button>
        <% } %>
        <% if (r.status === 'paused') { %>
          <button class="btn btn-sm btn-outline-success" hx-post="/api/rooms/<%= r.id %>/resume" hx-target="#roomsBody" hx-swap="innerHTML" hx-trigger="click">恢复</button>
          <button class="btn btn-sm btn-outline-danger" hx-post="/api/rooms/<%= r.id %>/stop" hx-target="#roomsBody" hx-swap="innerHTML" hx-confirm="确定停止录制？" hx-trigger="click">停止</button>
        <% } %>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
<% } %>
