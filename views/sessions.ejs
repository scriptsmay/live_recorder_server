<h2>录制会话</h2>

<div class="row mb-3">
  <div class="col-md-4">
    <select class="form-select" id="roomFilter">
      <option value="">全部直播间</option>
      <% rooms.forEach(r => { %>
        <option value="<%= r.room_url %>" <%= currentRoomUrl === r.room_url ? 'selected' : '' %>><%= r.room_name || r.room_url %></option>
      <% }) %>
    </select>
  </div>
</div>

<div id="sessionList">
<% if (sessions.length === 0) { %>
  <p class="text-muted text-center">暂无录制会话</p>
<% } else { %>
  <% sessions.forEach(s => { %>
    <% const uploads = uploadMap[s.id] || []; %>
    <% const hasSuccessUpload = uploads.some(u => u.status === 'success'); %>
    <% const statusBadge = { recording: '<span class="badge bg-primary">录制中</span>', completed: '<span class="badge bg-success">已完成</span>', interrupted: '<span class="badge bg-danger">中断</span>', pending: '<span class="badge bg-secondary">录制准备</span>' }[s.status] || s.status; %>
    <% const danmakuBadge = s.danmaku_status === 'recording' ? '<span class="badge bg-success">录制中 (' + (s.danmaku_event_count || 0) + '条)</span>' : s.danmaku_status === 'completed' ? '<span class="badge bg-info">已完成 (' + (s.danmaku_event_count || 0) + '条)</span>' : s.danmaku_status === 'failed' ? '<span class="badge bg-danger" title="' + (s.danmaku_error || '') + '">失败</span>' : '<span class="badge bg-secondary">—</span>'; %>
    <% const burnTotal = s.danmaku_burn_total || 0; const burnCompleted = s.danmaku_burn_completed || 0; const burnFailed = s.danmaku_burn_failed || 0; %>
    <% const burnBadge = burnTotal > 0 ? (burnFailed > 0 ? '<span class="badge bg-warning">' + burnCompleted + '/' + burnTotal + ' (' + burnFailed + '失败)</span>' : (burnCompleted === burnTotal ? '<span class="badge bg-success">完成 ' + burnCompleted + '/' + burnTotal + '</span>' : '<span class="badge bg-info">进行中 ' + burnCompleted + '/' + burnTotal + '</span>')) : '<span class="badge bg-secondary">—</span>'; %>
    <% const totalSize = s.total_size ? (s.total_size / 1024 / 1024).toFixed(1) + ' MB' : '-'; %>
    <div class="card mb-3 session-card">
      <div class="card-header d-flex justify-content-between align-items-center py-2">
        <div>
          <span class="badge bg-info me-2">#<%= s.id %></span>
          <strong><%= s.room_name || s.room_url %></strong>
          <small class="text-muted ms-2"><%= s.room_url || '' %></small>
        </div>
        <div>
          <%- statusBadge %>
          <button class="btn btn-sm btn-outline-danger ms-2 deleteSessionBtn" data-session-id="<%= s.id %>" title="删除会话">删除</button>
        </div>
      </div>
      
      <div class="card-body pt-2">
        <div class="row g-3">
          <!-- 左列：直播录制 + 投稿 -->
          <div class="col-md-6">
            <div class="section-block h-100">
              <h6 class="section-title text-primary mb-2 pb-1 border-bottom border-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-camera-video me-1" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M0 5a2 2 0 0 1 2-2h7.5a2 2 0 0 1 1.983 1.738l3.11-1.382A1 1 0 0 1 16 4.269v7.462a1 1 0 0 1-1.406.913l-3.111-1.382A2 2 0 0 1 9.5 13H2a2 2 0 0 1-2-2zm11.5 5.175 3.5 1.556V4.269l-3.5 1.556zM2 4a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h7.5a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1z"/></svg>
                <% if (s.caption) { %><%= s.caption %><% } %>
              </h6>
              <div class="row g-2 mb-2">
                <div class="col-6"><small class="text-muted d-block">开始时间</small><small><%= formatDate(s.started_at) %></small></div>
                <div class="col-6"><small class="text-muted d-block">结束时间</small><small><%= formatDate(s.ended_at) %></small></div>
                <div class="col-6"><small class="text-muted d-block">分片数</small><small><%= s.total_segments || 0 %> 段</small></div>
                <div class="col-6"><small class="text-muted d-block">文件大小</small><small><%= totalSize %></small></div>
              </div>
              <div class="mb-2">
                <small class="text-muted d-block">输出路径</small>
                <small class="text-break"><%= s.output_path %></small>
              </div>
              <div class="mb-2">
                <small class="text-muted d-block">直播流</small>
                <code class="small" style="cursor: pointer; word-break: break-all;" onclick="copyCode(this, '<%= s.stream_url %>')"><%= (s.stream_url || '').slice(0, 80) + '…' %></code>
              </div>
              <% if (uploads.length) { %>
                <div class="mb-2">
                  <small class="text-muted d-block mb-1">投稿记录</small>
                  <div>
                    <% uploads.forEach(u => { %>
                      <% const cls = { uploading: 'badge bg-primary', success: 'badge bg-success', failed: 'badge bg-danger' }[u.status] || 'badge bg-secondary'; %>
                      <span class="<%= cls %> me-1" title="<%= u.status %>"><%= u.bv_id ? 'BV ' + u.bv_id : u.status %></span>
                    <% }) %>
                  </div>
                </div>
              <% } %>
              <div class="mt-auto pt-2 d-flex flex-wrap gap-1">
                <button class="btn btn-sm btn-outline-secondary toggleFiles" data-session-id="<%= s.id %>">查看文件</button>
                <a class="btn btn-sm btn-outline-dark" href="/logs?file=<%= encodeURIComponent(downloader + '_' + s.id + '.log') %>" target="_blank">查看日志</a>
                <% if (!hasSuccessUpload && (s.status === 'completed' || s.status === 'interrupted')) { %>
                  <button class="btn btn-sm btn-outline-success uploadBtn" data-session-id="<%= s.id %>">投稿</button>
                <% } %>
              </div>
            </div>
          </div>
          <!-- 右列：弹幕生成 + 压制 -->
          <div class="col-md-6">
            <div class="section-block h-100">
              <h6 class="section-title text-success mb-2 pb-1 border-bottom border-success">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-chat-dots me-1" viewBox="0 0 16 16"><path d="M5 8a1 1 0 1 1-2 0 1 1 0 0 1 2 0m4 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0m3 1a1 1 0 1 0 0-2 1 1 0 0 0 0 2"/><path d="m2.165 15.803.02-.004c1.83-.363 2.948-.842 3.468-1.105A9 9 0 0 0 8 15c4.418 0 8-3.134 8-7s-3.582-7-8-7-8 3.134-8 7c0 1.76.743 3.37 1.97 4.6a10.4 10.4 0 0 1-.524 2.318l-.003.011a11 11 0 0 1-.244.637c-.079.186.074.394.272.362a22 22 0 0 0 .693-.125Z"/></svg>
                弹幕信息
              </h6>
              <div class="row g-2 mb-2">
                <div class="col-6">
                  <small class="text-muted d-block">弹幕状态</small>
                  <%- danmakuBadge %>
                </div>
                <div class="col-6">
                  <small class="text-muted d-block">压制状态</small>
                  <%- burnBadge %>
                </div>
              </div>
              <% if (burnTotal > 0 && burnCompleted < burnTotal && burnFailed === 0) { %>
                <div class="mb-2">
                  <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-info" role="progressbar" style="width: <%= Math.round(burnCompleted / burnTotal * 100) %>%" aria-valuenow="<%= burnCompleted %>" aria-valuemin="0" aria-valuemax="<%= burnTotal %>"></div>
                  </div>
                  <small class="text-muted"><%= Math.round(burnCompleted / burnTotal * 100) %>% 完成</small>
                </div>
              <% } %>
              <div class="mt-auto pt-2 d-flex flex-wrap gap-1">
                <a class="btn btn-sm btn-outline-primary" href="/sessions/<%= s.id %>/danmaku">弹幕详情</a>
                <% if (s.status === 'completed' || s.status === 'interrupted') { %>
                  <button class="btn btn-sm btn-outline-info genAssBtn" data-session-id="<%= s.id %>" title="重新生成 ASS 字幕">生成 ASS</button>
                  <button class="btn btn-sm btn-outline-warning burnDanmakuBtn" data-session-id="<%= s.id %>" title="将弹幕压制到视频上">压制弹幕</button>
                <% } %>
              </div>
            </div>
          </div>
        </div>
        <div class="mt-2 d-none filesContainer" id="files_<%= s.id %>">
          <div class="spinner-border spinner-border-sm"><span class="visually-hidden">加载中...</span></div>
        </div>
      </div>
    </div>
  <% }) %>
<% } %>
</div>

<% if (pagination.totalPages > 1) { %>
<div class="d-flex justify-content-between align-items-center mt-3">
  <small class="text-muted">共 <%= pagination.total %> 条记录</small>
  <nav aria-label="录制会话分页">
    <ul class="pagination pagination-sm mb-0">
      <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
        <a class="page-link" href="?page=<%= pagination.page - 1 %><%= currentRoomUrl ? '&room_url=' + encodeURIComponent(currentRoomUrl) : '' %>">上一页</a>
      </li>
      <%
        const maxPages = 7;
        let startPage = Math.max(1, pagination.page - 3);
        let endPage = Math.min(pagination.totalPages, startPage + maxPages - 1);
        if (endPage - startPage < maxPages - 1) {
          startPage = Math.max(1, endPage - maxPages + 1);
        }
        for (let i = startPage; i <= endPage; i++) {
      %>
        <li class="page-item <%= i === pagination.page ? 'active' : '' %>">
          <a class="page-link" href="?page=<%= i %><%= currentRoomUrl ? '&room_url=' + encodeURIComponent(currentRoomUrl) : '' %>"><%= i %></a>
        </li>
      <% } %>
      <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
        <a class="page-link" href="?page=<%= pagination.page + 1 %><%= currentRoomUrl ? '&room_url=' + encodeURIComponent(currentRoomUrl) : '' %>">下一页</a>
      </li>
    </ul>
  </nav>
</div>
<% } %>

<!-- 将投稿部分做成modal投稿 -->
<div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg"> 
    <div class="modal-content"> 
      <div class="modal-header">
        <h5 class="modal-title" id="uploadModalLabel">投稿录制会话<span class="text-muted ml-2" id="uploadSessionIdText"></span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="uploadForm">
          <input type="hidden" id="uploadSessionId">
          <div class="mb-3">
            <label for="uploadTmplSelect" class="form-label">选择投稿模板</label>
            <select id="uploadTmplSelect" class="form-select form-select-sm d-inline-block mx-1" required>
              <option value="">选择模板投稿</option>
              <% templates.forEach(t => { %>
                <option value="<%= t.id %>"><%= t.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <button type="submit" id="uploadSubmitBtn" class="btn btn-primary" disabled>提交投稿</button>
          </div>
          <div class="mb-3" id="uploadResultText"></div>
        </form>
        
        <div id="uploadStatusContainer" class="mt-3 d-none text-primary">
          <div class="spinner-border spinner-border-sm" role="status">
            <span class="visually-hidden">正在提交投稿...</span>
          </div>
          <span id="uploadStatus" class="ms-1">正在提交投稿...请稍候</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/recording-player.js"></script>
<%- include('partials/_video_player') %>

<script>
  document.getElementById('roomFilter')?.addEventListener('change', (e) => {
    const url = e.target.value ? '?room_url=' + encodeURIComponent(e.target.value) : '';
    window.location.href = '/sessions' + url;
  });

  // 列表中的操作按钮事件代理
  document.addEventListener('click', async (e) => {
    const toggle = e.target.closest('.toggleFiles');
    if (toggle) {
      const sid = toggle.dataset.sessionId;
      const container = document.getElementById('files_' + sid);
      container.classList.toggle('d-none');
      if (!container.classList.contains('d-none') && container.children.length === 1 && container.children[0].classList.contains('spinner-border')) {
        const res = await fetch('/api/recording_files?session_id=' + sid);
        const json = await res.json();
        container.innerHTML = '';
        if (!json.data || json.data.length === 0) {
          container.innerHTML = '<small class="text-muted">无分片文件</small>';
          return;
        }
        const table = document.createElement('table');
        table.className = 'table table-sm mb-0';
        table.innerHTML = '<thead><tr><th>#</th><th>文件路径</th><th>大小</th><th>HLS</th><th>弹幕</th><th>状态</th><th>操作</th></tr></thead><tbody>' +
          json.data.map(r => {
            const danmakuBadge = r.is_danmaku_burned
              ? '<span class="badge bg-success">已压制</span>'
              : (r.danmaku_ass_path ? '<span class="badge bg-info">ASS</span>' : '<span class="badge bg-secondary">无</span>');
            return '<tr>' +
            '<td>' + r.id + '</td>' +
            '<td><small>' + (r.file_path || '-') + '</small></td>' +
            '<td>' + (r.file_size ? (r.file_size / 1024 / 1024).toFixed(1) + ' MB' : '-') + '</td>' +
            '<td>' + (r.is_hls_ready ? '<span class="badge bg-success">就绪</span>' : '<span class="badge bg-secondary">未生成</span>') + '</td>' +
            '<td>' + danmakuBadge + '</td>' +
            '<td>' + (r.status === 'completed' ? '<span class="badge bg-success">完成</span>' : r.status === 'recording' ? '<span class="badge bg-primary">录制中</span>' : '<span class="badge bg-danger">中断</span>') + '</td>' +
            '<td>' + (r.file_exists ? '<button class="btn btn-sm btn-outline-info playRecBtn me-1" data-recording-id="' + r.id + '" data-filename="' + (r.file_path.split('/').pop() || '') + '" data-ext="' + ((r.file_path || '').split('.').pop() || '') + '">▶</button>' : '<span class="text-muted small">已删除</span>') +
            (r.is_danmaku_burned && r.file_exists ? '<button class="btn btn-sm btn-outline-success playRecBtn" data-recording-id="' + r.id + '" data-filename="' + (r.file_path.split('/').pop() || '') + '" data-ext="mp4" data-danmaku="true" title="播放弹幕压制版">▶弹幕</button>' : '') + '</td>' +
            '</tr>';
          }).join('') + '</tbody>';
        container.appendChild(table);
      }
      return;
    }

    const delBtn = e.target.closest('.deleteSessionBtn');
    if (delBtn) {
      showConfirm('确定删除此会话？此操作不会删除实际文件。').then(async confirmed => {
        if (!confirmed) return;
        const res = await fetch('/api/sessions/' + delBtn.dataset.sessionId, { method: 'DELETE' });
        const json = await res.json();
        if (!res.ok) { toast(json.message); return; }
        location.reload();
      });
      return;
    }

    // 生成 ASS 按钮
    const genAssBtn = e.target.closest('.genAssBtn');
    if (genAssBtn) {
      const sid = genAssBtn.dataset.sessionId;
      genAssBtn.disabled = true;
      genAssBtn.textContent = '生成中...';
      try {
        const res = await fetch('/api/sessions/' + sid + '/danmaku/ass', { method: 'POST' });
        const json = await res.json();
        if (res.ok && json.status === 'ok') {
          toast('ASS 生成成功: ' + json.data.event_count + ' 条弹幕');
        } else {
          toast('生成失败: ' + (json.message || '未知错误'));
        }
      } catch (err) {
        toast('请求失败: ' + err.message);
      } finally {
        genAssBtn.disabled = false;
        genAssBtn.textContent = '生成 ASS';
      }
      return;
    }

    // 压制弹幕按钮
    const burnBtn = e.target.closest('.burnDanmakuBtn');
    if (burnBtn) {
      const sid = burnBtn.dataset.sessionId;
      const confirmed = await showConfirm('确认将此会话加入弹幕压制队列？');
      if (!confirmed) return;
      burnBtn.disabled = true;
      burnBtn.textContent = '入队中...';
      try {
        const res = await fetch('/api/sessions/' + sid + '/danmaku/burn', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ force: false }),
        });
        const json = await res.json();
        if (res.ok && json.status === 'ok') {
          toast(json.message);
        } else {
          toast('入队失败: ' + (json.message || '未知错误'));
        }
      } catch (err) {
        toast('请求失败: ' + err.message);
      } finally {
        burnBtn.disabled = false;
        burnBtn.textContent = '压制弹幕';
      }
      return;
    }

  });


</script>

<script>
  // 声明一个全局的 modal 实例变量
  let uploadModalInstance = null;

  document.addEventListener('DOMContentLoaded', () => {
    // 1. 初始化相关组件
    if (typeof RecordingPlayer !== 'undefined') {
      RecordingPlayer.init();
    }

    const modalEl = document.getElementById('uploadModal');
    if (modalEl) {
      uploadModalInstance = new bootstrap.Modal(modalEl);
    }

    // 2. 监听模板选择，控制提交按钮状态
    document.getElementById('uploadTmplSelect')?.addEventListener('change', (e) => {
      document.getElementById('uploadSubmitBtn').disabled = !e.target.value;
    });

    // 3. 监听表单提交事件（而不是按钮点击）
    document.getElementById('uploadForm')?.addEventListener('submit', async (e) => {
      e.preventDefault(); // 关键：阻止表单默认提交刷新页面

      const confirmed = await showConfirm('确认投稿？'); // 假设 showConfirm 返回 Promise
      if (!confirmed) return;

      const sessionId = document.getElementById('uploadSessionId').value;
      const templateId = document.getElementById('uploadTmplSelect').value;
      const submitBtn = document.getElementById('uploadSubmitBtn');
      const resultText = document.getElementById('uploadResultText');
      const statusContainer = document.getElementById('uploadStatusContainer');

      // 提交前的 UI 状态更新
      resultText.textContent = '';
      resultText.className = '';
      submitBtn.disabled = true;
      submitBtn.textContent = '投稿中...';
      statusContainer.classList.remove('d-none'); // 显示加载动画

      try {
        const res = await fetch('/api/sessions/' + sessionId + '/upload', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ template_id: parseInt(templateId, 10) }),
        });
        
        const json = await res.json();
        
        if (!res.ok || json.status !== 'ok') {
          resultText.textContent = json.message || '投稿失败';
          resultText.className = 'text-danger';
        } else {
          uploadModalInstance.hide();
          toast(json.message || '投稿任务已提交');
          // 延迟一点关闭并刷新页面以显示最新状态（比如 BV 号或 uploading 标签）
          setTimeout(() => {
            location.reload();
          }, 2000);
        }

        // 成功状态
        submitBtn.textContent = '已提交';
        submitBtn.classList.replace('btn-primary', 'btn-success');

      } catch (error) {
        // 异常处理
        console.error('Upload error:', error);
        toast(error.message);
        submitBtn.disabled = false;
        submitBtn.textContent = '重新投稿';
      } finally {
        // 无论成功失败，隐藏加载动画
        statusContainer.classList.add('d-none');
      }
    });
  });

  // 全局事件代理 (保留你原有的 filter, toggleFiles, deleteBtn)
  document.getElementById('roomFilter')?.addEventListener('change', (e) => {
    const url = e.target.value ? '?room_url=' + encodeURIComponent(e.target.value) : '';
    window.location.href = '/sessions' + url;
  });

  document.addEventListener('click', async (e) => {
    
    // 打开投稿模态框
    const uploadBtn = e.target.closest('.uploadBtn');
    if (uploadBtn && !uploadBtn.disabled) {
      // 在显示之前，重置表单的状态，防止上一次的输入或错误提示残留
      document.getElementById('uploadSessionId').value = uploadBtn.dataset.sessionId;
      document.getElementById('uploadTmplSelect').value = '';
      document.getElementById('uploadResultText').textContent = '';
      document.getElementById('uploadSessionIdText').textContent = '#' + uploadBtn.dataset.sessionId;
      
      const submitBtn = document.getElementById('uploadSubmitBtn');
      submitBtn.disabled = true;
      submitBtn.textContent = '提交投稿';
      submitBtn.className = 'btn btn-primary'; // 恢复默认颜色
      
      document.getElementById('uploadStatusContainer').classList.add('d-none');

      uploadModalInstance?.show();
    }
  });
</script>