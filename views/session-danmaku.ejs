<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>
    会话 #<%= session.id %> 弹幕详情
    <a href="/sessions" class="btn btn-sm btn-outline-secondary ms-2">返回列表</a>
  </h2>
  <div>
    <button class="btn btn-outline-info" id="genAssBtn">重新生成 ASS</button>
    <button class="btn btn-outline-warning ms-1" id="burnAllBtn">全部加入压制队列</button>
  </div>
</div>

<!-- 会话基本信息 -->
<div class="row g-3 mb-4">
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header"><strong>会话信息</strong></div>
      <div class="card-body">
        <table class="table table-sm mb-0">
          <tr><td class="text-muted" style="width: 100px;">房间</td><td><%= room ? room.room_name || room.room_url : session.room_url %></td></tr>
          <tr><td class="text-muted">状态</td><td>
            <% const sBadge = { recording: '<span class="badge bg-primary">录制中</span>', completed: '<span class="badge bg-success">已完成</span>', interrupted: '<span class="badge bg-danger">中断</span>', pending: '<span class="badge bg-secondary">录制准备</span>' }[session.status] || session.status; %>
            <%- sBadge %>
          </td></tr>
          <tr><td class="text-muted">开始时间</td><td><%= session.started_at ? new Date(session.started_at).toLocaleString('zh-CN') : '-' %></td></tr>
          <tr><td class="text-muted">结束时间</td><td><%= session.ended_at ? new Date(session.ended_at).toLocaleString('zh-CN') : '-' %></td></tr>
          <tr><td class="text-muted">输出路径</td><td><small><code><%= session.output_path || session.output_dir %></code></small></td></tr>
        </table>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header">
        <strong>弹幕录制</strong>
        <span class="float-end">
          <% if (capture) { %>
            <% const dcrBadge = { recording: '<span class="badge bg-success">录制中</span>', completed: '<span class="badge bg-info">已完成</span>', failed: '<span class="badge bg-danger">失败</span>' }[capture.status] || capture.status; %>
            <%- dcrBadge %>
          <% } else { %>
            <span class="badge bg-secondary">未启用</span>
          <% } %>
        </span>
      </div>
      <div class="card-body">
        <% if (capture) { %>
          <table class="table table-sm mb-0">
            <tr><td class="text-muted" style="width: 100px;">弹幕事件</td><td><strong><%= capture.event_count || 0 %></strong> 条</td></tr>
            <tr><td class="text-muted">JSONL 路径</td><td><small><code><%= capture.raw_path || '-' %></code></small></td></tr>
            <tr><td class="text-muted">ASS 路径</td><td><small><code><%= capture.ass_path || '-' %></code></small></td></tr>
            <tr><td class="text-muted">开始采集</td><td><%= capture.started_at ? new Date(capture.started_at).toLocaleString('zh-CN') : '-' %></td></tr>
            <tr><td class="text-muted">结束采集</td><td><%= capture.ended_at ? new Date(capture.ended_at).toLocaleString('zh-CN') : '-' %></td></tr>
            <% if (capture.error) { %>
              <tr><td class="text-muted">错误</td><td><span class="text-danger"><%= capture.error %></span></td></tr>
            <% } %>
          </table>
        <% } else { %>
          <p class="text-muted">该会话未启用弹幕录制。</p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- 分段文件压制状态 -->
<div class="card mb-4">
  <div class="card-header"><strong>分段文件 & 压制状态</strong></div>
  <div class="card-body p-0">
    <% if (files.length === 0) { %>
      <p class="text-muted p-3 mb-0">无分段文件</p>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>#</th>
              <th>文件名</th>
              <th>大小</th>
              <th>分段时间</th>
              <th>弹幕 ASS</th>
              <th>压制状态</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            <% files.forEach(f => { %>
              <% const burnRec = burnRecords.find(b => b.recording_file_id === f.id); %>
              <tr>
                <td><%= f.id %></td>
                <td><small><%= (f.file_path || '').split('/').pop() || '-' %></small></td>
                <td><%= f.file_size ? (f.file_size / 1024 / 1024).toFixed(1) + ' MB' : '-' %></td>
                <td><small><%= f.segment_start_ms ? (f.segment_start_ms / 1000).toFixed(0) + 's' : '-' %> ~ <%= f.segment_end_ms ? (f.segment_end_ms / 1000).toFixed(0) + 's' : '-' %></small></td>
                <td>
                  <% if (f.danmaku_ass_exists) { %>
                    <span class="badge bg-info">ASS 就绪</span>
                  <% } else if (f.danmaku_ass_path) { %>
                    <span class="badge bg-warning">ASS 缺失</span>
                  <% } else { %>
                    <span class="badge bg-secondary">—</span>
                  <% } %>
                </td>
                <td>
                  <% if (burnRec) { %>
                    <% const burnBadge = { queued: '<span class="badge bg-secondary">排队中</span>', processing: '<span class="badge bg-primary">压制中</span>', completed: '<span class="badge bg-success">已完成</span>', failed: '<span class="badge bg-danger" title="' + (burnRec.error || '') + '">失败</span>', skipped: '<span class="badge bg-warning">跳过</span>' }[burnRec.status] || '<span class="badge bg-secondary">' + burnRec.status + '</span>'; %>
                    <%- burnBadge %>
                  <% } else { %>
                    <span class="badge bg-secondary">未压制</span>
                  <% } %>
                </td>
                <td>
                  <% if (burnRec && burnRec.status === 'completed') { %>
                    <span class="text-success small">✔</span>
                  <% } else if (f.danmaku_ass_exists) { %>
                    <button class="btn btn-sm btn-outline-warning burnFileBtn" data-recording-id="<%= f.id %>" data-session-id="<%= session.id %>">压制此段</button>
                  <% } else { %>
                    <span class="text-muted small">—</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<!-- 弹幕搜索面板 -->
<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <strong>弹幕搜索</strong>
    <div class="input-group input-group-sm" style="width: 320px;">
      <input type="text" class="form-control" id="danmakuSearchInput" placeholder="搜索弹幕内容或用户名..." />
      <button class="btn btn-outline-secondary" id="danmakuSearchBtn">搜索</button>
    </div>
  </div>
  <div class="card-body">
    <div id="danmakuSearchResult">
      <p class="text-muted text-center">输入关键词搜索弹幕</p>
    </div>
  </div>
</div>

<script>
  const SESSION_ID = '<%= session.id %>';

  // ASS 生成按钮
  document.getElementById('genAssBtn')?.addEventListener('click', async function() {
    this.disabled = true;
    this.textContent = '生成中...';
    try {
      const res = await fetch('/api/sessions/' + SESSION_ID + '/danmaku/ass', { method: 'POST' });
      const json = await res.json();
      if (res.ok && json.status === 'ok') {
        toast('ASS 生成成功: ' + json.data.event_count + ' 条弹幕');
        setTimeout(() => location.reload(), 1500);
      } else {
        toast('生成失败: ' + (json.message || '未知错误'));
      }
    } catch (err) {
      toast('请求失败: ' + err.message);
    } finally {
      this.disabled = false;
      this.textContent = '重新生成 ASS';
    }
  });

  // 全部压制按钮
  document.getElementById('burnAllBtn')?.addEventListener('click', async function() {
    const confirmed = await showConfirm('确认将全部可压制分段加入弹幕压制队列？');
    if (!confirmed) return;
    this.disabled = true;
    this.textContent = '入队中...';
    try {
      const res = await fetch('/api/sessions/' + SESSION_ID + '/danmaku/burn', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ force: false }),
      });
      const json = await res.json();
      if (res.ok && json.status === 'ok') {
        toast(json.message);
        setTimeout(() => location.reload(), 1500);
      } else {
        toast('入队失败: ' + (json.message || '未知错误'));
      }
    } catch (err) {
      toast('请求失败: ' + err.message);
    } finally {
      this.disabled = false;
      this.textContent = '全部加入压制队列';
    }
  });

  // 单段压制按钮
  document.addEventListener('click', async (e) => {
    const burnFileBtn = e.target.closest('.burnFileBtn');
    if (burnFileBtn) {
      const sid = burnFileBtn.dataset.sessionId;
      burnFileBtn.disabled = true;
      burnFileBtn.textContent = '入队中...';
      try {
        const res = await fetch('/api/sessions/' + sid + '/danmaku/burn', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ force: false }),
        });
        const json = await res.json();
        if (res.ok && json.status === 'ok') {
          toast(json.message);
          setTimeout(() => location.reload(), 1500);
        } else {
          toast('入队失败: ' + (json.message || '未知错误'));
        }
      } catch (err) {
        toast('请求失败: ' + err.message);
      } finally {
        burnFileBtn.disabled = false;
        burnFileBtn.textContent = '压制此段';
      }
    }
  });

  // 弹幕搜索
  let searchOffset = 0;
  async function searchDanmaku() {
    const keyword = document.getElementById('danmakuSearchInput').value.trim();
    const resultDiv = document.getElementById('danmakuSearchResult');

    if (!keyword) {
      resultDiv.innerHTML = '<p class="text-muted text-center">输入关键词搜索弹幕</p>';
      return;
    }

    resultDiv.innerHTML = '<div class="text-center"><div class="spinner-border spinner-border-sm"></div> 搜索中...</div>';

    try {
      const res = await fetch('/api/danmaku/search?session_id=' + SESSION_ID + '&keyword=' + encodeURIComponent(keyword) + '&limit=50&offset=' + searchOffset);
      const json = await res.json();

      if (!res.ok || json.status !== 'ok') {
        resultDiv.innerHTML = '<p class="text-danger">搜索失败: ' + (json.message || '未知错误') + '</p>';
        return;
      }

      if (json.data.length === 0) {
        resultDiv.innerHTML = '<p class="text-muted text-center">无匹配弹幕</p>';
        return;
      }

      let html = '<div class="mb-2"><small class="text-muted">共 ' + json.total + ' 条匹配 (显示 ' + (searchOffset + 1) + '-' + Math.min(searchOffset + json.data.length, json.total) + ')</small></div>';
      html += '<div class="table-responsive"><table class="table table-sm table-hover"><thead class="table-light"><tr><th style="width: 90px;">时间</th><th style="width: 120px;">用户</th><th>弹幕内容</th></tr></thead><tbody>';

      for (const d of json.data) {
        html += '<tr><td><small>' + (d.ts_str || '-') + '</small></td>';
        html += '<td><small>' + (d.username || '-') + '</small></td>';
        html += '<td>' + highlightKeyword(d.text, keyword) + '</td></tr>';
      }
      html += '</tbody></table></div>';

      // 分页
      if (json.total > json.limit) {
        html += '<div class="btn-group btn-group-sm">';
        if (searchOffset > 0) {
          html += '<button class="btn btn-outline-secondary" onclick="searchOffset=Math.max(0,searchOffset-' + json.limit + ');searchDanmaku()">上一页</button>';
        }
        if (searchOffset + json.limit < json.total) {
          html += '<button class="btn btn-outline-secondary" onclick="searchOffset+=' + json.limit + ';searchDanmaku()">下一页</button>';
        }
        html += '</div>';
      }

      resultDiv.innerHTML = html;
    } catch (err) {
      resultDiv.innerHTML = '<p class="text-danger">搜索异常: ' + err.message + '</p>';
    }
  }

  function highlightKeyword(text, keyword) {
    if (!keyword) return text;
    const escaped = keyword.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const re = new RegExp('(' + escaped + ')', 'gi');
    return text.replace(re, '<mark>$1</mark>');
  }

  document.getElementById('danmakuSearchBtn')?.addEventListener('click', () => { searchOffset = 0; searchDanmaku(); });
  document.getElementById('danmakuSearchInput')?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { searchOffset = 0; searchDanmaku(); }
  });
</script>
