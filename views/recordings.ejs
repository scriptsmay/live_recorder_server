<div class="d-flex align-items-center justify-content-between mb-3">
  <h4 class="mb-0 fw-bold">录制文件</h4>
  <small class="text-muted">共 <%= pagination.total %> 条记录</small>
</div>

<!-- 筛选标签条 -->
<div class="filter-bar mb-3">
  <div class="filter-group">
    <span class="filter-label">直播间：</span>
    <button class="filter-tag filter-tag-room-recording <%= roomFilter ? '' : 'active' %>" data-room="">全部</button>
    <% rooms.forEach(r => { %>
      <button class="filter-tag filter-tag-room-recording <%= r.room_url === roomFilter ? 'active' : '' %>"
              data-room="<%= r.room_url %>">
        <%= r.room_name || '直播间' %>
      </button>
    <% }) %>
  </div>
</div>

<% if (recordings.length === 0) { %>
  <div class="empty-state">
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 9l6 6M15 9l-6 6"/></svg>
    <p class="text-muted mt-2 mb-0">暂无录制记录</p>
  </div>
<% } else { %>
<div class="table-responsive room-table-wrap">
  <table class="table table-hover align-middle mb-0">
    <thead class="table-light">
      <tr>
        <th style="width:80px">ID</th>
        <th>直播间</th>
        <th>会话ID</th>
        <th>文件路径</th>
        <th style="width:75px">大小</th>
        <th style="width:55px">HLS</th>
        <th style="width:140px">状态</th>
        <th style="width:145px">开始时间</th>
        <th style="width:145px">结束时间</th>
        <th style="width:200px">操作</th>
      </tr>
    </thead>
    <tbody>
      <% recordings.forEach(r => {
        const statusMap = {
          recording: { cls: 'badge-recording', text: '录制中', dot: 'status-dot-mini-recording' },
          completed: { cls: 'badge-completed', text: '已完成', dot: 'status-dot-mini-completed' },
          interrupted: { cls: 'badge-failed', text: '中断', dot: 'status-dot-mini-interrupted' }
        };
        const badge = statusMap[r.status] || { cls: '', text: r.status, dot: '' };
        const size = r.file_size ? (r.file_size / 1024 / 1024).toFixed(1) + ' MB' : '-';
        const hlsBadge = r.is_hls_ready
          ? '<span class="badge bg-success" style="font-size:.72rem;padding:3px 7px;">就绪</span>'
          : '<span class="badge bg-secondary" style="font-size:.72rem;padding:3px 7px;">未生成</span>';
        const filename = r.file_path ? r.file_path.split('/').pop() : '';
        const ext = r.file_path ? (r.file_path.split('.').pop() || '') : '';
      %>
        <tr>
          <td><span class="text-muted font-monospace" style="font-size:.78rem;"><%= r.id %></span></td>
          <td>
            <div class="room-name-cell">
              <strong><%- r.room_name || '-' %></strong>
              <a href="<%= r.room_url %>" target="_blank" class="room-url-text"><%= r.room_url || '-' %></a>
            </div>
          </td>
          <td>
            <% if (r.session_id) { %>
              <a href="/sessions/<%= r.session_id %>" class="text-decoration-none">
                <span class="font-monospace" style="font-size:.78rem;color:#6b7280;"><%= r.session_id %></span>
              </a>
            <% } else { %><span class="text-muted">-</span><% } %>
          </td>
          <td title="<%= r.file_path || '' %>">
            <small class="info-value-path d-inline-block"><%= r.file_path || '-' %></small>
          </td>
          <td><span class="text-muted" style="font-size:.82rem;"><%= size %></span></td>
          <td><%- hlsBadge %></td>
          <td>
            <span class="session-status-badge <%= badge.cls %>">
              <% if (badge.dot) { %><span class="status-dot-mini <%= badge.dot %>"></span><% } %>
              <%= badge.text %>
            </span>
          </td>
          <td><small class="text-muted" style="font-size:.8rem;"><%= formatDate(r.session_started_at || r.started_at) %></small></td>
          <td><small class="text-muted" style="font-size:.8rem;"><%= formatDate(r.session_ended_at || r.ended_at) %></small></td>
          <td>
            <div class="action-group">
              <% if (r.status === 'completed' && r.file_path) { %>
                <button class="btn btn-sm btn-outline-info playRecBtn" data-recording-id="<%= r.id %>" data-filename="<%= filename %>" data-ext="<%= ext %>" title="播放">▶</button>
              <% } %>
              <% if (r.status === 'completed' && r.file_path && /\.(ts|flv|m2ts)$/i.test(r.file_path)) { %>
                <button class="btn btn-sm btn-outline-warning transcodeRecBtn" data-id="<%= r.id %>" data-filename="<%= filename %>" title="转码">转码</button>
              <% } %>
              <button class="btn btn-sm btn-outline-danger deleteRecBtn" data-id="<%= r.id %>" data-filename="<%= filename %>" title="删除">删除</button>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<!-- 分页 -->
<% if (pagination.totalPages > 1) { %>
<nav aria-label="录制文件分页" class="mt-3">
  <ul class="pagination pagination-sm justify-content-center mb-0">
    <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
      <a class="page-link" href="?page=<%= pagination.page - 1 %><%= roomFilter ? '&room_url=' + encodeURIComponent(roomFilter) : '' %>">上一页</a>
    </li>
    <%
      const maxPages = 7;
      let startPage = Math.max(1, pagination.page - 3);
      let endPage = Math.min(pagination.totalPages, startPage + maxPages - 1);
      if (endPage - startPage < maxPages - 1) {
        startPage = Math.max(1, endPage - maxPages + 1);
      }
      for (let i = startPage; i <= endPage; i++) {
    %>
      <li class="page-item <%= i === pagination.page ? 'active' : '' %>">
        <a class="page-link" href="?page=<%= i %><%= roomFilter ? '&room_url=' + encodeURIComponent(roomFilter) : '' %>"><%= i %></a>
      </li>
    <% } %>
    <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
      <a class="page-link" href="?page=<%= pagination.page + 1 %><%= roomFilter ? '&room_url=' + encodeURIComponent(roomFilter) : '' %>">下一页</a>
    </li>
  </ul>
</nav>
<% } %>
<% } %>

<script src="/js/recording-player.js"></script>
<%- include('partials/_video_player') %>

<script>
  // ====== DOM 就绪后统一初始化 ======
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof RecordingPlayer !== 'undefined') RecordingPlayer.init();

    // 筛选：直播间 Tag Pills 切换（URL 跳转）
    document.addEventListener('click', e => {
      const tag = e.target.closest('.filter-tag-room-recording');
      if (!tag) return;
      document.querySelectorAll('.filter-tag-room-recording').forEach(t => t.classList.remove('active'));
      tag.classList.add('active');
      const roomUrl = tag.dataset.room || '';
      window.location.href = roomUrl
        ? '?room_url=' + encodeURIComponent(roomUrl)
        : '/recordings';
    });

    // 删除按钮
    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('.deleteRecBtn');
      if (!btn) return;
      const filename = btn.dataset.filename || '';
      const msg = '确定删除此录制记录？'
        + (filename ? `<br><small class="text-muted">${filename}</small>` : '')
        + '<div class="form-check mt-3">'
        + '<input class="form-check-input" type="checkbox" id="deleteFileCheckbox">'
        + '<label class="form-check-label" for="deleteFileCheckbox">同时删除本地文件</label>'
        + '</div>';
      const confirmed = await showConfirm(msg, `#${btn.dataset.id}`);
      if (!confirmed) return;
      const deleteFile = document.getElementById('deleteFileCheckbox')?.checked || false;
      const id = btn.dataset.id;
      const url = '/api/recordings/' + id + (deleteFile ? '?delete_file=true' : '');
      const res = await fetch(url, { method: 'DELETE' });
      const json = await res.json();
      if (!res.ok) return toast(json.message || '删除失败');
      toast(deleteFile ? '已删除记录及本地文件' : '已删除记录');
      window.location.reload();
    });

    // 转码入队按钮
    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('.transcodeRecBtn');
      if (!btn) return;
      const id = btn.dataset.id;
      const filename = btn.dataset.filename;
      const confirmed = await showConfirm(`确定将文件加入转码队列？`, filename);
      if (!confirmed) return;
      btn.disabled = true;
      btn.textContent = '处理中…';
      try {
        const res = await fetch('/api/recordings/' + id + '/transcode', { method: 'POST' });
        const json = await res.json();
        if (!res.ok) return toast(json.message || '转码失败');
        toast(json.message || '已加入转码队列');
        btn.textContent = '已入队';
        btn.classList.remove('btn-outline-warning');
        btn.classList.add('btn-outline-secondary');
      } catch (err) {
        toast('请求失败');
        btn.disabled = false;
        btn.textContent = '转码';
      }
    });
  });
</script>
