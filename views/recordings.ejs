<h2>录制历史</h2>

<div class="row mb-3">
  <div class="col-md-4">
    <select class="form-select" id="roomFilter">
      <option value="">全部直播间</option>
      <% rooms.forEach(r => { %>
        <option value="<%= r.room_url %>" <%= r.room_url === roomFilter ? 'selected' : '' %>><%= r.room_name || r.room_url %></option>
      <% }) %>
    </select>
  </div>
</div>

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th>ID</th>
        <th>直播间</th>
        <th>文件路径</th>
        <th>大小</th>
        <th>HLS</th>
        <th>状态</th>
        <th>开始时间</th>
        <th>结束时间</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% if (recordings.length === 0) { %>
        <tr><td colspan="9" class="text-center text-muted py-4">暂无录制记录</td></tr>
      <% } else { %>
        <% recordings.forEach(r => { %>
          <% const badge = { recording: '<span class="badge bg-primary">录制中</span>', completed: '<span class="badge bg-success">已完成</span>', interrupted: '<span class="badge bg-danger">中断</span>' }[r.status] || r.status; %>
          <% const size = r.file_size ? (r.file_size / 1024 / 1024).toFixed(1) + ' MB' : '-'; %>
          <% const roomDisplay = r.room_name ? r.room_name + '<br><small class="text-muted">' + (r.room_url || '').slice(0, 30) + '…</small>' : (r.room_url || '-'); %>
          <% const hlsBadge = r.is_hls_ready ? '<span class="badge bg-success">就绪</span>' : '<span class="badge bg-secondary">未生成</span>'; %>
          <tr>
            <td><%= r.id %></td>
            <td><%- roomDisplay %></td>
            <td><small><%= r.file_path || '-' %></small></td>
            <td><%= size %></td>
            <td><%- hlsBadge %></td>
            <td><%- badge %></td>
            <td><small><%= formatDate(r.session_started_at || r.started_at) %></small></td>
            <td><small><%= formatDate(r.session_ended_at || r.ended_at) %></small></td>
            <td><button class="btn btn-sm btn-outline-danger deleteRecBtn" data-id="<%= r.id %>">删除</button></td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('partials/_pagination', { prefix: 'rec', hideFirst: true }) %>

<script>
  document.getElementById('roomFilter').addEventListener('change', e => {
    const url = e.target.value ? '?room_url=' + encodeURIComponent(e.target.value) : '/recordings';
    window.location.href = url;
  });

  document.addEventListener('click', async e => {
    const btn = e.target.closest('.deleteRecBtn');
    if (!btn) return;
    showConfirm('确定删除此录制记录？').then(async confirmed => {
      if (!confirmed) return;
      const id = btn.dataset.id;
      const res = await fetch('/api/recordings/' + id, { method: 'DELETE' });
      const json = await res.json();
      if (!res.ok) return toast(json.message || '删除失败');
      window.location.reload();
    });
  });
</script>
