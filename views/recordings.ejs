<h2>录制历史</h2>

<div class="row mb-3">
  <div class="col-md-4">
    <select class="form-select" id="roomFilter">
      <option value="">全部直播间</option>
    </select>
  </div>
</div>

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th>ID</th>
        <th>直播间</th>
        <th>文件路径</th>
        <th>大小</th>
        <th>状态</th>
        <th>开始时间</th>
        <th>结束时间</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody id="recordingsBody"></tbody>
  </table>
  <p class="text-muted text-center" id="emptyRecMsg">暂无录制记录</p>
</div>

<script>
async function loadRecordings(roomUrl) {
  let url = '/api/recordings?limit=200';
  if (roomUrl) url += '&room_url=' + encodeURIComponent(roomUrl);
  const res = await fetch(url);
  const json = await res.json();
  const tbody = document.getElementById('recordingsBody');
  const empty = document.getElementById('emptyRecMsg');
  tbody.innerHTML = '';
  if (!json.data || json.data.length === 0) {
    empty.style.display = '';
    return;
  }
  empty.style.display = 'none';
  json.data.forEach(r => {
    const statusBadge = {
      recording: '<span class="badge bg-primary">录制中</span>',
      completed: '<span class="badge bg-success">已完成</span>',
      interrupted: '<span class="badge bg-danger">中断</span>',
    }[r.status] || r.status;
    const size = r.file_size ? (r.file_size / 1024 / 1024).toFixed(1) + ' MB' : '-';
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td>${r.id}</td>
      <td>${r.room_name ? r.room_name + '<br><small class="text-muted">' + (r.room_url || '').slice(0, 30) + '…</small>' : r.room_url || '-'}</td>
      <td><small>${r.file_path || '-'}</small></td>
      <td>${size}</td>
      <td>${statusBadge}</td>
      <td><small>${r.started_at ? new Date(r.started_at).toLocaleString() : '-'}</small></td>
      <td><small>${r.ended_at ? new Date(r.ended_at).toLocaleString() : '-'}</small></td>
      <td><button class="btn btn-sm btn-outline-danger deleteRecBtn" data-id="${r.id}">删除</button></td>
    `;
    tbody.appendChild(tr);
  });
}

async function loadRoomFilter() {
  const res = await fetch('/api/rooms');
  const json = await res.json();
  const sel = document.getElementById('roomFilter');
  if (!json.data) return;
  json.data.forEach(r => {
    const opt = document.createElement('option');
    opt.value = r.room_url;
    opt.textContent = r.room_name || r.room_url;
    sel.appendChild(opt);
  });
}

document.getElementById('roomFilter').addEventListener('change', e => {
  loadRecordings(e.target.value);
});

document.addEventListener('click', async e => {
  const btn = e.target.closest('.deleteRecBtn');
  if (!btn) return;
  if (!confirm('确定删除此录制记录？')) return;
  const id = btn.dataset.id;
  const res = await fetch(`/api/recordings/${id}`, { method: 'DELETE' });
  const json = await res.json();
  if (!res.ok) return alert(json.message || '删除失败');
  loadRecordings(document.getElementById('roomFilter').value);
});

loadRoomFilter();
loadRecordings('');
</script>
