<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>直播间管理</h2>
  <div>
    <span class="badge bg-info me-2"><%= '\u2699 ' + downloader %></span>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#roomModal">+ 新增直播间</button>
  </div>
</div>

<div class="table-responsive">
  <table class="table table-hover align-middle" id="roomsTable">
    <thead class="table-light">
      <tr>
        <th>ID</th>
        <th>名称</th>
        <th>直播间地址</th>
        <th>录制状态</th>
        <th>通知</th>
        <th>监听</th>
        <th>轮询</th>
        <th>直播状态</th>
        <th>最后检测</th>
        <th>投稿模板</th>
        <th>文件名模板</th>
        <th>分段时间</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody id="roomsBody">
      <% if (rooms.length === 0) { %>
      <tr>
        <td colspan="11" class="text-center text-muted py-4">暂无直播间数据</td>
      </tr>
      <% } else { %>
      <% rooms.forEach(r => { %>
      <% const statusBadge = { idle: '<span class="badge bg-secondary">空闲</span>', recording: '<span class="badge bg-success">录制中</span>', paused: '<span class="badge bg-warning text-dark">已暂停</span>' }[r.status] || r.status; %>
      <% const seg = r.segment_duration; %>
      <tr>
        <td><%= r.id %></td>
        <td><%= r.room_name || '-' %></td>
        <td><a href="<%= r.room_url %>" target="_blank" title="<%= r.room_url %>"><%= r.room_url %></a></td>
        <td><%- statusBadge %></td>
        <td><% if (r.notification_enabled !== false) { %><span class="badge bg-info text-dark">开</span><% } else { %><span class="badge bg-secondary">关</span><% } %></td>
        <td><% if (r.monitoring_enabled !== false) { %><span class="badge bg-info text-dark">开</span><% } else { %><span class="badge bg-secondary">关</span><% } %></td>
        <td><% if (r.polling_enabled) { %>
          <span class="badge bg-info text-dark">开</span>
          <% } else { %>
          <span class="badge bg-secondary">关</span>
          <% } %>
        </td>
        <td>
          <% if (r.last_live_status) { %>
          <span class="badge bg-danger">🔴 直播中</span>
          <% } else if (r.polling_enabled) { %>
          <span class="badge bg-secondary">⚫ 未开播</span>
          <% } else { %>
          <span class="text-muted">-</span>
          <% } %>
        </td>
        <td>
          <% if (r.last_polled_at) { %>
          <small><%= new Date(r.last_polled_at).toLocaleString('zh-CN') %></small>
          <% } else { %>
          <span class="text-muted">-</span>
          <% } %>
        </td>
        <td><%= r.upload_template_name || (r.upload_template_id ? '#' + r.upload_template_id : '-') %></td>
        <td><code><%= r.filename_template || '{room_name}_{datetime}' %></code></td>
        <td><%= seg ? (seg >= 3600 ? Math.round(seg/3600)+'h' : seg+'s') : '-' %></td>
        <td class="text-nowrap">
          <% if (r.status === 'idle') { %>
          <button class="btn btn-sm btn-outline-primary editBtn" data-id="<%= r.id %>">编辑</button>
          <button class="btn btn-sm btn-outline-danger delRoomBtn" data-id="<%= r.id %>">删除</button>
          <% } else if (r.status === 'recording') { %>
          <button class="btn btn-sm btn-outline-primary editBtn" data-id="<%= r.id %>" data-limited="1">编辑</button>
          <button class="btn btn-sm btn-outline-warning actBtn" data-id="<%= r.id %>" data-action="pause">暂停</button>
          <button class="btn btn-sm btn-outline-danger actBtn" data-id="<%= r.id %>" data-action="stop">停止</button>
          <% } else if (r.status === 'paused') { %>
          <button class="btn btn-sm btn-outline-primary editBtn" data-id="<%= r.id %>" data-limited="1">编辑</button>
          <button class="btn btn-sm btn-outline-success actBtn" data-id="<%= r.id %>" data-action="resume">恢复</button>
          <button class="btn btn-sm btn-outline-danger actBtn" data-id="<%= r.id %>" data-action="stop">停止</button>
          <% } %>
        </td>
      </tr>
      <% }) %>
      <% } %>
    </tbody>
  </table>
</div>

<!-- 创建/编辑 Modal -->
<div class="modal fade" id="roomModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalTitle">新增直播间</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div id="modalBody" class="modal-body">
        <input type="hidden" id="editId" value="" />
        <input type="hidden" id="editLimited" value="0" />
        <div id="roomFormLimitedHint" class="alert alert-info d-none mb-0">
          录制或暂停中，仅可修改通知开关与投稿模板。
        </div>
        <div class="mb-3" data-room-field="context">
          <label class="form-label">直播间地址 <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="inputUrl" placeholder="https://live.example.com/room" />
        </div>
        <div class="mb-3" data-room-field="context">
          <label class="form-label">直播间名称</label>
          <input type="text" class="form-control" id="inputName" placeholder="主播名" />
        </div>
        <div class="mb-3" data-room-field="full">
          <label class="form-label">文件名模板</label>
          <input type="text" class="form-control" id="inputTemplate" placeholder="{room_name}_{datetime}" />
          <div class="form-text">支持：<code>{room_name}</code> <code>{datetime}</code> <code>{YYYY}</code> <code>{MM}</code> <code>{DD}</code> <code>{HH}</code> <code>{mm}</code> <code>{ss}</code></div>
        </div>
        <div class="mb-3" data-room-field="full">
          <label class="form-label">分段录制时长（秒，0 表示不分段）</label>
          <input type="number" class="form-control" id="inputSegment" min="0" step="60" value="0" />
          <div class="form-text">设为 3600 即每 1 小时自动分割为一个文件</div>
        </div>
        <div class="form-check form-switch mb-2">
          <input class="form-check-input" type="checkbox" id="inputNotify" checked />
          <label class="form-check-label" for="inputNotify">启用通知</label>
          <div class="form-text">关闭后，开始录制、投稿通知将不会发送</div>
        </div>
        <div class="form-check form-switch mb-2" data-room-field="full">
          <input class="form-check-input" type="checkbox" id="inputMonitor" checked />
          <label class="form-check-label" for="inputMonitor">启用监听</label>
          <div class="form-text">关闭后，即使收到录制通知也不会启动 ffmpeg 下载</div>
        </div>
        <div class="form-check form-switch mb-2" data-room-field="full">
          <input class="form-check-input" type="checkbox" id="inputPolling" />
          <label class="form-check-label" for="inputPolling">启用轮询</label>
          <div class="form-text">开启后，将定期查询直播间开播状态（支持虎牙、斗鱼、B站、Twitch、抖音、TwitCasting）</div>
        </div>
        <div class="mb-3" data-room-field="full" id="pollingIntervalConfig" style="display: none;">
          <label class="form-label">轮询间隔（秒）</label>
          <input type="number" class="form-control" id="inputPollingInterval" min="30" max="3600" value="60" />
          <div class="form-text">建议不少于 30 秒，避免请求过于频繁</div>
        </div>
        <div class="mb-3" data-room-field="limited">
          <label class="form-label">投稿模板</label>
          <select class="form-select" id="inputTemplateId">
            <option value="">不使用模板</option>
            <% templates.forEach(t => { %>
            <option value="<%= t.id %>"><%= t.name %></option>
            <% }) %>
          </select>
          <div class="form-text">选择后，该直播间录制完成且转码就绪时会自动投稿；不选择则不自动投稿（仍可于会话页手动投稿）</div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
        <button type="button" class="btn btn-primary" id="saveBtn">保存</button>
      </div>
    </div>
  </div>
</div>

<script>
  async function apiAction(url, method, body) {
    const res = await fetch(url, {
      method,
      headers: {
        'Content-Type': 'application/json'
      },
      body: body ? JSON.stringify(body) : undefined
    });
    if (!res.ok) {
      const json = await res.json().catch(() => ({}));
      alert(json.message || '操作失败');
    }
    return res;
  }

  function detectPlatform(url) {
    const platformMap = {
      'huya.com': 'huya',
      'douyu.com': 'douyu',
      'live.bilibili.com': 'bilibili',
      'twitch.tv': 'twitch',
      'douyin.com': 'douyin',
      'twitcasting.tv': 'twitcasting'
    };

    for (const [domain, platform] of Object.entries(platformMap)) {
      const regex = new RegExp(`^(?:https?:\\/\\/)?.*?${domain}\\/(.+?)$`, 'i');
      if (regex.test(url)) {
        return platform;
      }
    }
    return null;
  }

  function setRoomFormMode(limited) {
    document.getElementById('editLimited').value = limited ? '1' : '0';
    document.getElementById('roomFormLimitedHint').classList.toggle('d-none', !limited);
    document.querySelectorAll('[data-room-field="full"]').forEach((el) => {
      el.classList.toggle('d-none', limited);
    });
    const nameInput = document.getElementById('inputName');
    nameInput.disabled = limited;
    document.getElementById('inputUrl').disabled = !!document.getElementById('editId').value;
  }

  document.getElementById('saveBtn').addEventListener('click', async () => {
    const id = document.getElementById('editId').value;
    const limited = document.getElementById('editLimited').value === '1';
    const url = document.getElementById('inputUrl').value.trim();
    const name = document.getElementById('inputName').value.trim();
    const tmpl = document.getElementById('inputTemplate').value.trim();
    const segment = parseInt(document.getElementById('inputSegment').value, 10) || 0;
    const notify = document.getElementById('inputNotify').checked;
    const monitor = document.getElementById('inputMonitor').checked;
    const templateId = document.getElementById('inputTemplateId').value;
    const polling = document.getElementById('inputPolling').checked;
    const pollingInterval = parseInt(document.getElementById('inputPollingInterval').value, 10) || 60;

    if (!url && !id) return alert('直播间地址必填');

    const body = limited ? {
      notification_enabled: notify,
      upload_template_id: templateId ? parseInt(templateId, 10) : null,
    } : {
      room_name: name,
      filename_template: tmpl || undefined,
      segment_duration: segment,
      notification_enabled: notify,
      monitoring_enabled: monitor,
      upload_template_id: templateId ? parseInt(templateId, 10) : null,
      polling_enabled: polling,
      polling_interval: polling ? pollingInterval : 60,
    };
    const res = id ?
      await apiAction(`/api/rooms/${id}`, 'PUT', body) :
      await apiAction('/api/rooms', 'POST', {
        room_url: url,
        ...body
      });

    if (res.ok) {
      location.reload();
    }
  });

  function resetForm() {
    document.getElementById('modalTitle').textContent = '新增直播间';
    document.getElementById('editId').value = '';
    setRoomFormMode(false);
    document.getElementById('inputUrl').disabled = false;
    document.getElementById('inputUrl').value = '';
    document.getElementById('inputName').value = '';
    document.getElementById('inputName').disabled = false;
    document.getElementById('inputTemplate').value = '';
    document.getElementById('inputSegment').value = 0;
    document.getElementById('inputNotify').checked = true;
    document.getElementById('inputMonitor').checked = true;
    document.getElementById('inputTemplateId').value = '';
    document.getElementById('inputPolling').checked = false;
    document.getElementById('inputPollingInterval').value = 60;
    document.getElementById('pollingIntervalConfig').style.display = 'none';
  }

  document.getElementById('inputPolling').addEventListener('change', function() {
    const isEnabled = this.checked;
    document.getElementById('pollingIntervalConfig').style.display = isEnabled ? '' : 'none';
  });

  document.getElementById('roomModal').addEventListener('hidden.bs.modal', resetForm);

  document.addEventListener('click', e => {
    const btn = e.target.closest('.editBtn');
    if (btn) {
      const id = btn.dataset.id;
      const limited = btn.dataset.limited === '1';
      fetch(`/api/rooms/${id}`)
        .then(r => r.json())
        .then(json => {
          if (!json.data) return;
          const r = json.data;
          document.getElementById('modalTitle').textContent = limited ? '编辑（录制中）' : '编辑直播间';
          document.getElementById('editId').value = r.id;
          setRoomFormMode(limited);
          document.getElementById('inputUrl').value = r.room_url;
          document.getElementById('inputUrl').disabled = true;
          document.getElementById('inputName').value = r.room_name || '';
          document.getElementById('inputTemplate').value = r.filename_template || '';
          document.getElementById('inputSegment').value = r.segment_duration || 0;
          document.getElementById('inputNotify').checked = r.notification_enabled !== false;
          document.getElementById('inputMonitor').checked = r.monitoring_enabled !== false;
          document.getElementById('inputTemplateId').value = r.upload_template_id || '';
          document.getElementById('inputPolling').checked = r.polling_enabled === true;
          document.getElementById('inputPollingInterval').value = r.polling_interval || 60;
          const pollingEnabled = r.polling_enabled === true;
          document.getElementById('pollingIntervalConfig').style.display = pollingEnabled ? '' : 'none';
          new bootstrap.Modal(document.getElementById('roomModal')).show();
        });
      return;
    }
    const actBtn = e.target.closest('.actBtn');
    if (actBtn) {
      const id = actBtn.dataset.id;
      const action = actBtn.dataset.action;
      const confirmMsg = {
        stop: '确定停止录制？',
        delete: '确定删除此直播间？'
      } [action];
      if (confirmMsg && !confirm(confirmMsg)) return;
      apiAction(`/api/rooms/${id}/${action}`, 'POST').then(r => {
        if (r.ok) location.reload();
      });
      return;
    }
    const delBtn = e.target.closest('.delRoomBtn');
    if (delBtn) {
      if (!confirm('确定删除此直播间？')) return;
      apiAction(`/api/rooms/${delBtn.dataset.id}`, 'DELETE').then(r => {
        if (r.ok) location.reload();
      });
    }
  });
</script>