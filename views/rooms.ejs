<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>直播间管理</h2>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#roomModal">+ 新增直播间</button>
</div>

<div class="table-responsive">
  <table class="table table-hover align-middle" id="roomsTable">
    <thead class="table-light">
      <tr>
        <th>ID</th>
        <th>名称</th>
        <th>直播间地址</th>
        <th>状态</th>
        <th>通知</th>
        <th>监听</th>
        <th>文件名模板</th>
        <th>分段时间</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody id="roomsBody"></tbody>
  </table>
  <p class="text-muted text-center" id="emptyRooms">暂无直播间数据</p>
</div>
<%- include('partials/_pagination', { prefix: 'room', hideFirst: true }) %>

<!-- 创建/编辑 Modal -->
<div class="modal fade" id="roomModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalTitle">新增直播间</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div id="modalBody" class="modal-body">
        <input type="hidden" id="editId" value="" />
        <div class="mb-3">
          <label class="form-label">直播间地址 <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="inputUrl" placeholder="https://live.example.com/room" />
        </div>
        <div class="mb-3">
          <label class="form-label">直播间名称</label>
          <input type="text" class="form-control" id="inputName" placeholder="主播名" />
        </div>
        <div class="mb-3">
          <label class="form-label">文件名模板</label>
          <input type="text" class="form-control" id="inputTemplate" placeholder="{room_name}_{datetime}" />
          <div class="form-text">支持：<code>{room_name}</code> <code>{datetime}</code> <code>{YYYY}</code> <code>{MM}</code> <code>{DD}</code> <code>{HH}</code> <code>{mm}</code> <code>{ss}</code></div>
        </div>
        <div class="mb-3">
          <label class="form-label">分段录制时长（秒，0 表示不分段）</label>
          <input type="number" class="form-control" id="inputSegment" min="0" step="60" value="0" />
          <div class="form-text">设为 3600 即每 1 小时自动分割为一个文件</div>
        </div>
        <div class="form-check form-switch mb-2">
          <input class="form-check-input" type="checkbox" id="inputNotify" checked />
          <label class="form-check-label" for="inputNotify">启用通知</label>
          <div class="form-text">关闭后，开始录制、投稿通知将不会发送</div>
        </div>
        <div class="form-check form-switch mb-2">
          <input class="form-check-input" type="checkbox" id="inputMonitor" checked />
          <label class="form-check-label" for="inputMonitor">启用监听</label>
          <div class="form-text">关闭后，即使收到录制通知也不会启动 ffmpeg 下载</div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
        <button type="button" class="btn btn-primary" id="saveBtn">保存</button>
      </div>
    </div>
  </div>
</div>

<script>
async function apiAction(url, method, body) {
  const res = await fetch(url, {
    method,
    headers: { 'Content-Type': 'application/json' },
    body: body ? JSON.stringify(body) : undefined
  });
  if (!res.ok) {
    const json = await res.json().catch(() => ({}));
    alert(json.message || '操作失败');
  }
  return res;
}

async function loadRooms() {
  const res = await fetch('/api/rooms');
  const json = await res.json();
  const tbody = document.getElementById('roomsBody');
  const empty = document.getElementById('emptyRooms');
  tbody.innerHTML = '';
  if (!json.data || json.data.length === 0) { empty.style.display = ''; return; }
  empty.style.display = 'none';
  setupPagination('room', json.data, (pageData) => {
    tbody.innerHTML = '';
    pageData.forEach(r => {
      const statusBadge = { idle: '<span class="badge bg-secondary">空闲</span>', recording: '<span class="badge bg-success">录制中</span>', paused: '<span class="badge bg-warning text-dark">已暂停</span>' }[r.status] || r.status;
      const seg = r.segment_duration;
      tbody.innerHTML += `<tr>
        <td>${r.id}</td>
        <td>${r.room_name || '-'}</td>
        <td><a href="${r.room_url}" target="_blank" title="${r.room_url}">${r.room_url}</a></td>
        <td>${statusBadge}</td>
        <td>${r.notification_enabled !== false ? '<span class="badge bg-info text-dark">开</span>' : '<span class="badge bg-secondary">关</span>'}</td>
        <td>${r.monitoring_enabled !== false ? '<span class="badge bg-info text-dark">开</span>' : '<span class="badge bg-secondary">关</span>'}</td>
        <td><code>${r.filename_template || '{room_name}_{datetime}'}</code></td>
        <td>${seg ? (seg >= 3600 ? Math.round(seg/3600)+'h' : seg+'s') : '-'}</td>
        <td class="text-nowrap">
          ${r.status === 'idle' ? `<button class="btn btn-sm btn-outline-primary editBtn" data-id="${r.id}">编辑</button>
          <button class="btn btn-sm btn-outline-danger delRoomBtn" data-id="${r.id}">删除</button>` : ''}
          ${r.status === 'recording' ? `<button class="btn btn-sm btn-outline-warning actBtn" data-id="${r.id}" data-action="pause">暂停</button>
          <button class="btn btn-sm btn-outline-danger actBtn" data-id="${r.id}" data-action="stop">停止</button>` : ''}
          ${r.status === 'paused' ? `<button class="btn btn-sm btn-outline-success actBtn" data-id="${r.id}" data-action="resume">恢复</button>
          <button class="btn btn-sm btn-outline-danger actBtn" data-id="${r.id}" data-action="stop">停止</button>` : ''}
        </td>
      </tr>`;
    });
  });
}

document.getElementById('saveBtn').addEventListener('click', async () => {
  const id = document.getElementById('editId').value;
  const url = document.getElementById('inputUrl').value.trim();
  const name = document.getElementById('inputName').value.trim();
  const tmpl = document.getElementById('inputTemplate').value.trim();
  const segment = parseInt(document.getElementById('inputSegment').value, 10) || 0;
  const notify = document.getElementById('inputNotify').checked;
  const monitor = document.getElementById('inputMonitor').checked;

  if (!url && !id) return alert('直播间地址必填');

  const body = { room_name: name, filename_template: tmpl || undefined, segment_duration: segment, notification_enabled: notify, monitoring_enabled: monitor };
  const res = id
    ? await apiAction(`/api/rooms/${id}`, 'PUT', body)
    : await apiAction('/api/rooms', 'POST', { room_url: url, ...body });

  if (res.ok) {
    bootstrap.Modal.getInstance(document.getElementById('roomModal')).hide();
    resetForm();
    loadRooms();
  }
});

function resetForm() {
  document.getElementById('modalTitle').textContent = '新增直播间';
  document.getElementById('editId').value = '';
  document.getElementById('inputUrl').disabled = false;
  document.getElementById('inputUrl').value = '';
  document.getElementById('inputName').value = '';
  document.getElementById('inputTemplate').value = '';
  document.getElementById('inputSegment').value = 0;
  document.getElementById('inputNotify').checked = true;
  document.getElementById('inputMonitor').checked = true;
}

document.getElementById('roomModal').addEventListener('hidden.bs.modal', resetForm);

document.addEventListener('click', e => {
  const btn = e.target.closest('.editBtn');
  if (btn) {
    const id = btn.dataset.id;
    fetch(`/api/rooms/${id}`)
      .then(r => r.json())
      .then(json => {
        if (!json.data) return;
        const r = json.data;
        document.getElementById('modalTitle').textContent = '编辑直播间';
        document.getElementById('editId').value = r.id;
        document.getElementById('inputUrl').value = r.room_url;
        document.getElementById('inputUrl').disabled = true;
        document.getElementById('inputName').value = r.room_name || '';
        document.getElementById('inputTemplate').value = r.filename_template || '';
        document.getElementById('inputSegment').value = r.segment_duration || 0;
        document.getElementById('inputNotify').checked = r.notification_enabled !== false;
        document.getElementById('inputMonitor').checked = r.monitoring_enabled !== false;
        new bootstrap.Modal(document.getElementById('roomModal')).show();
      });
    return;
  }
  const actBtn = e.target.closest('.actBtn');
  if (actBtn) {
    const id = actBtn.dataset.id;
    const action = actBtn.dataset.action;
    const confirmMsg = { stop: '确定停止录制？', delete: '确定删除此直播间？' }[action];
    if (confirmMsg && !confirm(confirmMsg)) return;
    apiAction(`/api/rooms/${id}/${action}`, 'POST').then(r => { if (r.ok) loadRooms(); });
    return;
  }
  const delBtn = e.target.closest('.delRoomBtn');
  if (delBtn) {
    if (!confirm('确定删除此直播间？')) return;
    apiAction(`/api/rooms/${delBtn.dataset.id}`, 'DELETE').then(r => { if (r.ok) loadRooms(); });
  }
});

loadRooms();
</script>
