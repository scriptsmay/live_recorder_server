<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>直播间管理</h2>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#roomModal">+ 新增直播间</button>
</div>

<div id="roomsBody" hx-get="/_/rooms/table" hx-trigger="load" hx-swap="innerHTML"></div>

<!-- 创建/编辑 Modal -->
<div class="modal fade" id="roomModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalTitle">新增直播间</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div id="modalBody" class="modal-body">
        <input type="hidden" id="editId" value="" />
        <div class="mb-3">
          <label class="form-label">直播间地址 <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="inputUrl" placeholder="https://live.example.com/room" />
        </div>
        <div class="mb-3">
          <label class="form-label">直播间名称</label>
          <input type="text" class="form-control" id="inputName" placeholder="主播名" />
        </div>
        <div class="mb-3">
          <label class="form-label">文件名模板</label>
          <input type="text" class="form-control" id="inputTemplate" placeholder="{room_name}_{datetime}" />
          <div class="form-text">支持：<code>{room_name}</code> <code>{datetime}</code> <code>{YYYY}</code> <code>{MM}</code> <code>{DD}</code> <code>{HH}</code> <code>{mm}</code> <code>{ss}</code></div>
        </div>
        <div class="mb-3">
          <label class="form-label">分段录制时长（秒，0 表示不分段）</label>
          <input type="number" class="form-control" id="inputSegment" min="0" step="60" value="0" />
          <div class="form-text">设为 3600 即每 1 小时自动分割为一个文件</div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
        <button type="button" class="btn btn-primary" id="saveBtn">保存</button>
      </div>
    </div>
  </div>
</div>

<script>
async function apiAction(url, method, body) {
  const res = await fetch(url, {
    method,
    headers: { 'Content-Type': 'application/json' },
    body: body ? JSON.stringify(body) : undefined
  });
  if (!res.ok) {
    const json = await res.json().catch(() => ({}));
    alert(json.message || '操作失败');
  }
  return res;
}

document.getElementById('saveBtn').addEventListener('click', async () => {
  const id = document.getElementById('editId').value;
  const url = document.getElementById('inputUrl').value.trim();
  const name = document.getElementById('inputName').value.trim();
  const tmpl = document.getElementById('inputTemplate').value.trim();
  const segment = parseInt(document.getElementById('inputSegment').value, 10) || 0;

  if (!url && !id) return alert('直播间地址必填');

  const res = id
    ? await apiAction(`/api/rooms/${id}`, 'PUT', { room_name: name, filename_template: tmpl || undefined, segment_duration: segment })
    : await apiAction('/api/rooms', 'POST', { room_url: url, room_name: name, filename_template: tmpl || undefined, segment_duration: segment });

  if (res.ok) {
    bootstrap.Modal.getInstance(document.getElementById('roomModal')).hide();
    resetForm();
    htmx.trigger('#roomsBody', 'load');
  }
});

function resetForm() {
  document.getElementById('modalTitle').textContent = '新增直播间';
  document.getElementById('editId').value = '';
  document.getElementById('inputUrl').disabled = false;
  document.getElementById('inputUrl').value = '';
  document.getElementById('inputName').value = '';
  document.getElementById('inputTemplate').value = '';
  document.getElementById('inputSegment').value = 0;
}

document.getElementById('roomModal').addEventListener('hidden.bs.modal', resetForm);

document.addEventListener('click', e => {
  const btn = e.target.closest('.editBtn');
  if (!btn) return;
  const id = btn.dataset.id;
  fetch(`/api/rooms/${id}`)
    .then(r => r.json())
    .then(json => {
      if (!json.data) return;
      const r = json.data;
      document.getElementById('modalTitle').textContent = '编辑直播间';
      document.getElementById('editId').value = r.id;
      document.getElementById('inputUrl').value = r.room_url;
      document.getElementById('inputUrl').disabled = true;
      document.getElementById('inputName').value = r.room_name || '';
      document.getElementById('inputTemplate').value = r.filename_template || '';
      document.getElementById('inputSegment').value = r.segment_duration || 0;
      new bootstrap.Modal(document.getElementById('roomModal')).show();
    });
});
</script>
