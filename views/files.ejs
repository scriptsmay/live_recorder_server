<h2>文件管理</h2>

<ul class="nav nav-tabs mb-3" id="fileTabs">
  <li class="nav-item">
    <button class="nav-link active" data-status="orphaned">孤文件</button>
  </li>
  <li class="nav-item">
    <button class="nav-link" data-status="recording">录制中</button>
  </li>
  <li class="nav-item">
    <button class="nav-link" data-status="completed">已完成</button>
  </li>
  <li class="nav-item">
    <button class="nav-link" data-status="interrupted">中断</button>
  </li>
  <li class="nav-item">
    <button class="nav-link" data-status="missing">缺失</button>
  </li>
  <li class="nav-item ms-auto">
    <button class="btn btn-sm btn-outline-danger d-none" id="clearMissingBtn" onclick="clearMissing()">一键清空</button>
  </li>
</ul>

<div id="fileList"><div class="text-center text-muted py-4">加载中...</div></div>
<%- include('partials/_pagination', { prefix: 'file', hideFirst: true }) %>

<div class="modal fade" id="sessionModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-scrollable" style="max-width: 1000px;">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">选择会话 - <span id="modalFileName"></span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-0">
        <div class="text-center text-muted py-4" id="modalLoading">加载中...</div>
        <div id="sessionTableWrap" class="d-none">
          <input class="form-control form-control-sm m-2" style="width:auto" id="sessionSearch" placeholder="搜索ID或主播名...">
          <table class="table table-sm table-hover mb-0">
            <thead class="table-light"><tr>
              <th>ID</th>
              <th>主播</th>
              <th>开始时间</th>
              <th>文件数</th>
              <th>大小</th>
              <th>状态</th>
              <th>操作</th>
            </tr></thead>
            <tbody id="sessionTbody"></tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">取消</button>
      </div>
    </div>
  </div>
</div>

<script>
  let currentStatus = 'orphaned';

  async function loadFiles(status) {
    currentStatus = status;
    document.getElementById('clearMissingBtn').classList.toggle('d-none', status !== 'missing');
    await fetch('/api/scan_files', { method: 'POST' }).catch(() => {});
    const res = await fetch(`/api/recording_files?status=${status}`);
    const json = await res.json();
    const container = document.getElementById('fileList');
    container.innerHTML = '';
    if (!json.data || json.data.length === 0) {
      container.innerHTML = '<p class="text-muted text-center py-4">无文件</p>';
      return;
    }
    setupPagination('file', json.data, (pageData) => {
      container.innerHTML = '';
      for (const f of pageData) {
      const card = document.createElement('div');
      card.className = 'card mb-2';
      card.innerHTML = `
        <div class="card-body py-2">
          <div class="d-flex justify-content-between align-items-start">
            <div class="flex-grow-1 me-3" style="min-width:0">
              <strong>${f.file_name}</strong>
              <div class="text-truncate"><small class="text-muted">${f.file_path}</small></div>
              <small class="text-muted">${f.file_size ? (f.file_size / 1024 / 1024).toFixed(1) + ' MB' : '-'}</small>
              ${f.session_id ? `<small class="text-muted ms-2">会话: ${f.session_id}</small>` : ''}
            </div>
            ${status === 'orphaned' ? `
            <div class="flex-shrink-0">
              <button class="btn btn-sm btn-outline-primary associateOpenBtn" data-file-id="${f.id}" data-file-name="${f.file_name}">关联会话</button>
            </div>` : ''}
          </div>
        </div>`;
      container.appendChild(card);
    }
    });
    document.querySelectorAll('.associateOpenBtn').forEach(btn => {
      btn.addEventListener('click', () => openSessionModal(btn.dataset.fileId, btn.dataset.fileName));
    });
  }

  async function openSessionModal(fileId, fileName) {
    document.getElementById('modalFileName').textContent = fileName;
    document.getElementById('modalLoading').classList.remove('d-none');
    document.getElementById('sessionTableWrap').classList.add('d-none');
    const modal = new bootstrap.Modal(document.getElementById('sessionModal'));
    modal.show();

    const res = await fetch('/api/sessions?limit=200');
    const json = await res.json();
    const sessions = json.data || [];
    document.getElementById('modalLoading').classList.add('d-none');
    document.getElementById('sessionTableWrap').classList.remove('d-none');

    const tbody = document.getElementById('sessionTbody');
    function renderSessions(list) {
      tbody.innerHTML = list.map(s => `
        <tr>
          <td>${s.id}</td>
          <td>${s.room_name || s.room_url || '-'}</td>
          <td><small>${s.started_at ? new Date(s.started_at).toLocaleString() : '-'}</small></td>
          <td>${s.total_segments || 0}</td>
          <td>${s.total_size ? (s.total_size / 1024 / 1024).toFixed(1) + ' MB' : '-'}</td>
          <td>${s.status}</td>
          <td><button class="btn btn-sm btn-outline-success doAssociateBtn" data-file-id="${fileId}" data-session-id="${s.id}">关联</button></td>
        </tr>
      `).join('');
      document.querySelectorAll('.doAssociateBtn').forEach(btn => {
        btn.addEventListener('click', async () => {
          btn.disabled = true;
          btn.textContent = '关联中...';
          try {
            const r = await fetch(`/api/recording_files/${btn.dataset.fileId}/associate`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ session_id: parseInt(btn.dataset.sessionId) }),
            });
            const j = await r.json();
            if (r.ok) {
              modal.hide();
              loadFiles(currentStatus);
            } else {
              alert(j.message || '关联失败');
              btn.disabled = false;
              btn.textContent = '关联';
            }
          } catch (err) {
            alert('关联失败');
            btn.disabled = false;
            btn.textContent = '关联';
          }
        });
      });
    }
    renderSessions(sessions);

    document.getElementById('sessionSearch').oninput = (e) => {
      const q = e.target.value.toLowerCase();
      renderSessions(sessions.filter(s => String(s.id).includes(q) || (s.room_name || '').toLowerCase().includes(q) || (s.room_url || '').toLowerCase().includes(q)));
    };
  }

  async function clearMissing() {
    if (!confirm('确定删除所有缺失文件记录？此操作不可恢复。')) return;
    const btn = document.getElementById('clearMissingBtn');
    btn.disabled = true;
    btn.textContent = '删除中...';
    try {
      const res = await fetch('/api/recording_files/missing', { method: 'DELETE' });
      const json = await res.json();
      if (res.ok) {
        loadFiles('missing');
      } else {
        alert(json.message || '删除失败');
        btn.disabled = false;
        btn.textContent = '一键清空';
      }
    } catch (_) {
      alert('删除失败');
      btn.disabled = false;
      btn.textContent = '一键清空';
    }
  }

  document.querySelectorAll('#fileTabs .nav-link').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('#fileTabs .nav-link').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      loadFiles(tab.dataset.status);
    });
  });

  loadFiles('orphaned');
</script>
