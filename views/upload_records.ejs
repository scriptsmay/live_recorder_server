<h2>投稿记录</h2>

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th>ID</th>
        <th>会话ID</th>
        <th>标题</th>
        <th>投稿文件</th>
        <th>状态</th>
        <th>BV号</th>
        <th>开始时间</th>
        <th>结束时间</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% if (records.length === 0) { %>
        <tr><td colspan="10" class="text-center text-muted py-4">暂无投稿记录</td></tr>
      <% } else { %>
        <% records.forEach(r => { %>
          <% const badge = {
            pending: '<span class="badge bg-secondary">等待</span>',
            uploading: '<span class="badge bg-primary">上传中</span>',
            success: '<span class="badge bg-success">成功</span>',
            failed: '<span class="badge bg-danger">失败</span>',
          }[r.status] || r.status; %>
          <% const size = r.total_size ? (r.total_size / 1024 / 1024).toFixed(1) + ' MB' : '-'; %>
          <tr>
            <td><%= r.id %></td>
            <td><%= r.session_id || '-' %></td>
            <td>
              <div><%= r.title || '-' %>
                <% if (r.template_name) { %><br><span class="text-muted small"><%= r.template_name %></span><% } %>
              </div>
            </td>
            <td>
              <button class="btn btn-md btn-link p-0 viewFilesBtn" data-files='<%= encodeURIComponent(r.upload_files || "[]") %>' data-id="<%= r.id %>">
                <%= r.file_count %>个
              </button>
              <span class="small text-muted ml-2">[<%= size %>]</span>
            </td>
            <td><%- badge %></td>
            <td>
              <% if (r.bv_id) { %>
                <a href="https://www.bilibili.com/video/<%= r.bv_id %>" target="_blank" rel="noopener">
                  <code><%= r.bv_id %></code>
                </a>
              <% } else { %>
                -
              <% } %>
            </td>
            <td>
              <div class="small"><%= formatDate(r.started_at) %></div>
            </td>
            <td>
              <div class="small"><%= formatDate(r.completed_at) %></div>
            </td>
            <td>
              <a class="btn btn-sm btn-outline-dark mb-1" href="/logs?file=<%= encodeURIComponent('biliup_' + r.id + '.log') %>" target="_blank">日志</a>
              <button class="btn btn-sm btn-outline-info viewOutputBtn" data-id="<%= r.id %>" data-output="<%= encodeURIComponent(r.output || '') %>">输出</button>
              <button class="btn btn-sm btn-outline-danger deleteRecBtn" data-id="<%= r.id %>">删除</button>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>


<div class="d-flex justify-content-between align-items-center mt-3">
  <small class="text-muted">共 <%= pagination.total %> 条记录</small>
  <% if (pagination.totalPages > 1) { %>
  <nav aria-label="投稿记录分页">
    <ul class="pagination pagination-sm mb-0">
      <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
        <a class="page-link" href="?page=<%= pagination.page - 1 %>">上一页</a>
      </li>
      <%
        const maxPages = 7;
        let startPage = Math.max(1, pagination.page - 3);
        let endPage = Math.min(pagination.totalPages, startPage + maxPages - 1);
        if (endPage - startPage < maxPages - 1) {
          startPage = Math.max(1, endPage - maxPages + 1);
        }
        for (let i = startPage; i <= endPage; i++) {
      %>
        <li class="page-item <%= i === pagination.page ? 'active' : '' %>">
          <a class="page-link" href="?page=<%= i %>"><%= i %></a>
        </li>
      <% } %>
      <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
        <a class="page-link" href="?page=<%= pagination.page + 1 %>">下一页</a>
      </li>
    </ul>
  </nav>
  <% } %>
</div>

<div class="modal fade" id="filesModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">投稿文件 - #<span id="filesRecId"></span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="filesContent">
          <div class="text-center text-muted py-3">加载中...</div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="outputModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">输出 - #<span id="outputRecId"></span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <pre class="mb-0" style="font-size:12px; white-space:pre-wrap; word-break:break-all; max-height:70vh; overflow-y:auto;" id="outputContent"></pre>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('click', async e => {
    const btn = e.target.closest('[class*="Btn"]');
    if (!btn) return;

    if (btn.classList.contains('deleteRecBtn')) {
      showConfirm('确定删除此投稿记录？', `#${btn.dataset.id}`).then(async confirmed => {
        if (!confirmed) return;
        await fetch(`/api/upload_records/${btn.dataset.id}`, { method: 'DELETE' });
        window.location.reload();
      });
      return;
    }

    if (btn.classList.contains('viewOutputBtn')) {
      const output = decodeURIComponent(btn.dataset.output) || '(无输出)';
      document.getElementById('outputRecId').textContent = btn.dataset.id;
      document.getElementById('outputContent').textContent = output;
      new bootstrap.Modal(document.getElementById('outputModal')).show();
      return;
    }

    if (btn.classList.contains('viewFilesBtn')) {
      const recId = btn.dataset.id;
      const filesContent = document.getElementById('filesContent');
      const title = document.getElementById('filesRecId');
      title.textContent = recId;
      filesContent.innerHTML = '<div class="text-center text-muted py-3">加载中...</div>';
      new bootstrap.Modal(document.getElementById('filesModal')).show();

      try {
        const files = JSON.parse(decodeURIComponent(btn.dataset.files || '[]'));
        if (!files || files.length === 0) {
          filesContent.innerHTML = '<div class="text-muted text-center py-3">无文件记录</div>';
          return;
        }
        let html = '<table class="table table-sm mb-0"><thead><tr><th>#</th><th>文件路径</th></tr></thead><tbody>';
        files.forEach((fp, i) => {
          html += `<tr><td>${i + 1}</td><td><small title="${fp}">${fp}</small></td></tr>`;
        });
        html += '</tbody></table>';
        filesContent.innerHTML = html;
      } catch (err) {
        filesContent.innerHTML = '<div class="alert alert-danger mb-0">加载失败</div>';
      }
      return;
    }
  });
</script>
