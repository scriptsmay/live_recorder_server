<h2>投稿记录</h2>

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th>ID</th>
        <th>标题</th>
        <th>模板</th>
        <th>文件数</th>
        <th>大小</th>
        <th>状态</th>
        <th>BV号</th>
        <th>时间</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody id="recordsBody"></tbody>
  </table>
  <p class="text-muted text-center" id="emptyRec">暂无投稿记录</p>
</div>

<div class="modal fade" id="filesModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">投稿文件 - #<span id="filesRecId"></span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="filesContent">
          <div class="text-center text-muted py-3">加载中...</div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="outputModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">输出 - #<span id="outputRecId"></span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <pre class="mb-0" style="font-size:12px; white-space:pre-wrap; word-break:break-all; max-height:70vh; overflow-y:auto;" id="outputContent"></pre>
      </div>
    </div>
  </div>
</div>

<script>
async function loadRecords() {
  const res = await fetch('/api/upload_records?limit=100');
  const json = await res.json();
  const tbody = document.getElementById('recordsBody');
  const empty = document.getElementById('emptyRec');
  tbody.innerHTML = '';
  if (!json.data || json.data.length === 0) { empty.style.display = ''; return; }
  empty.style.display = 'none';
  json.data.forEach(r => {
    const badge = {
      pending: '<span class="badge bg-secondary">等待</span>',
      uploading: '<span class="badge bg-primary">上传中</span>',
      success: '<span class="badge bg-success">成功</span>',
      failed: '<span class="badge bg-danger">失败</span>',
    }[r.status] || r.status;
    const size = r.total_size ? (r.total_size / 1024 / 1024).toFixed(1) + ' MB' : '-';
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td>${r.id}</td>
      <td><small>${r.title || '-'}${r.template_name ? '<br><span class="text-muted small">' + r.template_name + '</span>' : ''}</small></td>
      <td>${r.template_name || '-'}</td>
      <td><button class="btn btn-sm btn-link p-0 viewFilesBtn" data-session-id="${r.session_id || ''}" data-id="${r.id}">${r.file_count}</button></td>
      <td>${size}</td>
      <td>${badge}</td>
      <td>${r.bv_id ? '<a href="https://www.bilibili.com/video/' + r.bv_id + '" target="_blank" rel="noopener"><code>' + r.bv_id + '</code></a>' : '-'}</td>
      <td><small>${r.completed_at ? new Date(r.completed_at).toLocaleString() : (r.started_at ? new Date(r.started_at).toLocaleString() : '-')}</small></td>
      <td>
        <button class="btn btn-sm btn-outline-info viewOutputBtn" data-id="${r.id}" data-output="${encodeURIComponent(r.output || '')}">输出</button>
        <button class="btn btn-sm btn-outline-danger deleteRecBtn" data-id="${r.id}">删除</button>
      </td>`;
    tbody.appendChild(tr);
  });
}

document.addEventListener('click', async e => {
  const btn = e.target.closest('[class*="Btn"]');
  if (!btn) return;
  if (btn.classList.contains('deleteRecBtn')) {
    if (!confirm('确定删除此记录？')) return;
    await fetch(`/api/upload_records/${btn.dataset.id}`, { method: 'DELETE' });
    loadRecords();
  }
  if (btn.classList.contains('viewOutputBtn')) {
    const output = decodeURIComponent(btn.dataset.output) || '(无输出)';
    document.getElementById('outputRecId').textContent = btn.dataset.id;
    document.getElementById('outputContent').textContent = output;
    new bootstrap.Modal(document.getElementById('outputModal')).show();
  }
  if (btn.classList.contains('viewFilesBtn')) {
    const sessionId = btn.dataset.sessionId;
    const recId = btn.dataset.id;
    const content = document.getElementById('filesContent');
    const title = document.getElementById('filesRecId');
    title.textContent = recId;
    content.innerHTML = '<div class="text-center text-muted py-3">加载中...</div>';
    new bootstrap.Modal(document.getElementById('filesModal')).show();
    if (!sessionId) {
      content.innerHTML = '<div class="text-muted text-center py-3">无关联会话</div>';
      return;
    }
    try {
      const res = await fetch(`/api/sessions/${sessionId}`);
      const json = await res.json();
      const recs = json.data?.recordings;
      if (!recs || recs.length === 0) {
        content.innerHTML = '<div class="text-muted text-center py-3">无文件记录</div>';
        return;
      }
      let html = '<table class="table table-sm mb-0"><thead><tr><th>#</th><th>文件路径</th><th>大小</th><th>状态</th></tr></thead><tbody>';
      recs.forEach(r => {
        const sz = r.file_size ? (r.file_size / 1024 / 1024).toFixed(1) + ' MB' : '-';
        const st = r.status === 'completed' ? '<span class="badge bg-success">完成</span>' : r.status === 'recording' ? '<span class="badge bg-primary">录制中</span>' : '<span class="badge bg-danger">中断</span>';
        html += `<tr><td>${r.segment_index}</td><td><small>${r.file_path || '-'}</small></td><td>${sz}</td><td>${st}</td></tr>`;
      });
      html += '</tbody></table>';
      content.innerHTML = html;
    } catch (err) {
      content.innerHTML = '<div class="alert alert-danger mb-0">加载失败</div>';
    }
  }
});

loadRecords();
</script>
