<div class="text-end">
  <a href="/logs" class="text-muted small"><span>&#128203;</span> 查看完整日志</a>
</div>

<script>
  const REFRESH_INTERVAL = 5000;
  let autoRefresh = true;
  let refreshTimer = null;

  function formatDuration(ms) {
    if (!ms) return '-';
    const target = new Date(ms);
    if (isNaN(target.getTime())) return '-';

    const sec = Math.floor((Date.now() - target.getTime()) / 1000);
    if (sec < 60) return sec + '秒';
    if (sec < 3600) return Math.floor(sec / 60) + '分' + (sec % 60) + '秒';
    const h = Math.floor(sec / 3600);
    const m = Math.floor((sec % 3600) / 60);
    return h + '时' + m + '分';
  }

  async function loadDashboard() {
    try {
      const res = await fetch('/api/dashboard/status');
      const json = await res.json();
      if (json.status !== 'ok') return;
      const d = json.data;

      // 概览卡片
      document.getElementById('activeCount').textContent = d.active_count;
      document.getElementById('poolInfo').textContent = '线程池 ' + d.active_count + '/' + d.pool_size;
      document.getElementById('transcodeProcessing').textContent = d.transcode.processing;
      document.getElementById('transcodeConcurrency').textContent = '并发上限 ' + d.transcode.concurrency;
      document.getElementById('transcodeQueue').textContent = d.transcode.queue_length;

      const idle = d.active_count === 0 && d.transcode.processing === 0 && d.transcode.queue_length === 0;
      document.getElementById('systemStatus').textContent = idle ? '空闲' : '工作中';
      document.getElementById('systemDetail').textContent = idle ? '所有进程空闲' : '有活跃任务';

      // 活跃录制表格
      const tbody = document.getElementById('activeBody');
      if (d.active_recordings.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">暂无活跃录制</td></tr>';
      } else {
        tbody.innerHTML = d.active_recordings
          .map(
            (r) =>
              '<tr>' +
              '<td>' +
              (r.room_name || r.room_url) +
              '</td>' +
              '<td><code>' +
              r.pid +
              '</code></td>' +
              '<td><a href="/sessions?room_url=' +
              encodeURIComponent(r.room_url) +
              '">#' +
              r.session_id +
              '</a></td>' +
              '<td><span class="badge bg-info">' +
              r.downloader +
              '</span></td>' +
              '<td>' +
              formatDuration(r.started_at) +
              '</td>' +
              '</tr>'
          )
          .join('');
      }

      // // 转码进度条
      // const tc = d.transcode;
      // const slotPct = tc.concurrency > 0 ? Math.min(100, Math.round((tc.processing / tc.concurrency) * 100)) : 0;
      // document.getElementById('slotText').textContent = tc.processing + '/' + tc.concurrency;
      // const slotBar = document.getElementById('slotBar');
      // slotBar.style.width = slotPct + '%';
      // slotBar.textContent = slotPct + '%';
      // slotBar.className = 'progress-bar ' + (slotPct >= 100 ? 'bg-danger' : slotPct > 50 ? 'bg-warning' : 'bg-success');

      // const queuePct = Math.min(100, tc.queue_length * 10);
      // document.getElementById('queueText').textContent = tc.queue_length + ' 个任务';
      // const queueBar = document.getElementById('queueBar');
      // queueBar.style.width = queuePct + '%';
      // queueBar.textContent = tc.queue_length;
    } catch (err) {
      console.error('仪表盘加载失败:', err);
    }
  }

  document.getElementById('toggleRefreshBtn').addEventListener('click', function () {
    autoRefresh = !autoRefresh;
    this.textContent = autoRefresh ? '暂停刷新' : '恢复刷新';
    document.getElementById('refreshBadge').textContent = autoRefresh ? '自动刷新: 5s' : '已暂停';
    if (autoRefresh) scheduleRefresh();
  });

  function scheduleRefresh() {
    if (refreshTimer) clearTimeout(refreshTimer);
    if (!autoRefresh) return;
    refreshTimer = setTimeout(() => {
      loadDashboard().then(scheduleRefresh);
    }, REFRESH_INTERVAL);
  }

  loadDashboard().then(scheduleRefresh);
</script>
