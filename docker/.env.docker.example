NODE_ENV=production
PORT=1123

POSTGRES_DB=live_recorder
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@postgres:5432/live_recorder

REDIS_PASSWORD=password
REDIS_URL=redis://default:password@redis:6379/1

APP_DATA_DIR=/data
VIDEO_DOWNLOAD_DIR=/data/video_downloads
REPLAY_WORK_DIR=/data/replay
BILIUP_WORK_DIR=/data/biliup

# 可选：自定义 biliup 二进制路径。Docker 镜像默认已将 biliup 加入 PATH。
# BILIUP_PATH=biliup

# 消息通知（可选；未配置则静默跳过）
MESSAGE_FEISHU_WEBHOOK=
MESSAGE_GOTIFY_SERVER=
MESSAGE_GOTIFY_TOKEN=
MESSAGE_GOTIFY_PRIORITY=5

# 轮询平台 Cookie（可选；用于提高平台请求成功率）
POLLING_DOUYIN_COOKIE=
POLLING_KUAISHOU_COOKIE=

# 快手轮询 Checker（可选；默认远程浏览器模式，需要外部 Browserless/Chromium）
# 模式切换：默认 remote-browser，设为 api 则使用 HTTP API 直连（无需 Browserless）
# KUAISHOU_CHECKER_MODE=remote-browser
KUAISHOU_CHECKER_ENABLED=true

# 远程浏览器模式配置
# connectOverCDP 使用 Browserless CDP endpoint；Docker overlay 见 docker-compose.browserless.yml
# REMOTE_BROWSER_WS_ENDPOINT=ws://browserless:3000/chromium?token=${BROWSERLESS_TOKEN:-change-me-browserless-token}

# 可选：随 Docker Compose 一起启动 Browserless 时使用。
# 请在生产环境改成高强度随机值；compose overlay 会自动把它注入 app endpoint。
BROWSERLESS_TOKEN=change-me-browserless-token
BROWSERLESS_CONCURRENT=1
BROWSERLESS_QUEUED=5
BROWSERLESS_TIMEOUT_MS=60000

# API 直连模式配置（KUAISHOU_CHECKER_MODE=api 时生效）
# KUAISHOU_API_TIMEOUT_MS=15000

# NAS 备份（可选）
# Docker 部署通常直接通过 ./data/video_downloads 持久化录制文件。
# 如果模板设置了 after_upload=backup 但未配置 NAS_*，系统会跳过 NAS 备份。
# NAS_HOST=192.168.1.100
# NAS_USER=username
# NAS_BACKUP_DIR=/volume1/video_backups
