# 阶段 1: 构建依赖
FROM node:22-bookworm-slim AS builder

WORKDIR /app

# 替换 apt 源为阿里云镜像，并安装必要的构建工具
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources \
    && sed -i 's/security.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3 build-essential && rm -rf /var/lib/apt/lists/*

COPY package*.json ./

# 使用阿里云 npm 镜像加速安装
RUN npm config set registry https://registry.npmmirror.com \
    && npm install --omit=dev

# 阶段 2: 运行环境
FROM node:22-bookworm-slim

ENV LANG=C.UTF-8 \
    NODE_ENV=production \
    PORT=1123 \
    APP_DATA_DIR=/data

WORKDIR /app

# 替换 apt 源为阿里云镜像，并安装运行期依赖
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources \
    && sed -i 's/security.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl ffmpeg mkvtoolnix python3 python3-pip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# 使用阿里云 PyPI 镜像加速 uv 安装 biliup
RUN pip3 install --break-system-packages --no-cache-dir uv -i https://mirrors.aliyun.com/pypi/simple/ \
    && uv tool install biliup --python /usr/bin/python3 --index-url https://mirrors.aliyun.com/pypi/simple/ \
    && ln -sf /root/.local/share/uv/tools/biliup/bin/biliup /usr/local/bin/biliup

# 从构建阶段复制依赖和源码
COPY --from=builder /app/node_modules ./node_modules
COPY . .

RUN mkdir -p /data/video_downloads /data/biliup /app/logs \
    && chmod +x scripts/docker-entrypoint.sh

EXPOSE 1123

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:1123/api/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

ENTRYPOINT ["./scripts/docker-entrypoint.sh"]
CMD ["node", "app.js"]
