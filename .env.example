# express 配置
NODE_ENV=production
PORT=1123
VIDEO_DOWNLOAD_DIR=/data/video_downloads

# PostgreSQL 数据库配置
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=live_recorder
DB_USER=postgres
DB_PASSWORD=

# Redis 配置（用于缓存直播间数据、录制任务锁）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USER=default
REDIS_DB=1

# NAS 备份配置（投稿后处理 after_upload=backup 时使用）
NAS_HOST=192.168.1.100
NAS_USER=username
NAS_BACKUP_DIR=/volume1/video_backups
