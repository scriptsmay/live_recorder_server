# express 配置
NODE_ENV=production
PORT=1123
APP_DATA_DIR=/data
VIDEO_DOWNLOAD_DIR=/data/video_downloads
REPLAY_WORK_DIR=/data/replay
# yt-dlp 回放下载临时目录；Docker 生产可挂载 SSD 到 /tmp/yt_dlp_cache
YTDLP_TEMP_DIR=/tmp/yt_dlp_cache
# 弹幕归档目录（file-manage 保护，不可自动清理）
DANMAKU_ARCHIVE_DIR=/data/danmaku_archive

# 登录鉴权
ADMIN_USERNAME=admin
AUTH_TOKEN_TTL_HOURS=24
AUTH_COOKIE_NAME=auth_token
AUTH_COOKIE_SECURE=false
LOGIN_RATE_LIMIT=5
LOGIN_LOCKOUT_MIN=5
AUTH_ENABLED=true

# PostgreSQL 数据库配置
# Docker 推荐使用 DATABASE_URL；旧部署可继续使用下方拆分变量
# DATABASE_URL=postgresql://postgres:password@postgres:5432/live_recorder
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=live_recorder
DB_USER=postgres
DB_PASSWORD=

# scripts/sync-db-tables.sh 的源库（生产）连接参数 —— 仅本地开发同步数据用
# 缺省时脚本报错退出（不在脚本里硬编码生产地址）；SRC_USER / SRC_PASSWORD 缺省沿用上面的 DB_USER / DB_PASSWORD
# SRC_HOST=
# SRC_PORT=5432

# Redis 配置（用于缓存直播间数据、录制任务锁）
# Docker 推荐使用 REDIS_URL；旧部署可继续使用下方拆分变量
# REDIS_URL=redis://default:password@redis:6379/1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USER=default
REDIS_DB=1

# biliup 工作目录（Docker 默认 /data/biliup）
BILIUP_WORK_DIR=/data/biliup
# biliup cookie 文件路径策略：auto（默认，按运行环境判定）/ strict（仅允许白名单目录）/ any（任意绝对路径）
# auto = 容器内 strict（VIDEO_DOWNLOAD_DIR / REPLAY_WORK_DIR / BILIUP_WORK_DIR 白名单），
# 宿主机直跑（npm start / npm run dev）为 any，允许开发机上的任意绝对路径
# BILIUP_COOKIE_PATH_MODE=auto

# 投稿后自动加入合集（v1.11.0，全部可选；仅 SEASON_AUTO_ADD_ENABLED=false 才关闭）
# 总开关：设为 false 关闭自动加入，其他值均视为开启
SEASON_AUTO_ADD_ENABLED=true
# 投稿成功后延迟多久再入合集（毫秒，给 B 站稿件转码留时间；0 表示不等待）
SEASON_ADD_DELAY_MS=45000
# 单条记录最多尝试次数（含首次）
SEASON_ADD_MAX_ATTEMPTS=3
# 首次重试退避基数（毫秒，指数递增：30s / 60s / 120s）
SEASON_ADD_BACKOFF_MS=30000
# 合集接口超时（毫秒）
SEASON_HTTP_TIMEOUT_MS=10000
# 合集列表 Redis 缓存 TTL（秒）
SEASON_LIST_CACHE_TTL=600
# 合集列表分页条数
SEASON_SEASONS_PAGE_SIZE=30

# 消息通知（可选；未配置则静默跳过）
MESSAGE_ENABLED=false
MESSAGE_FEISHU_WEBHOOK=
MESSAGE_GOTIFY_SERVER=
MESSAGE_GOTIFY_TOKEN=
MESSAGE_GOTIFY_PRIORITY=5

# 轮询配置（可选）
# 抖音 Cookie，用于提高 Web API 请求成功率；未配置时也能工作
POLLING_DOUYIN_COOKIE=
# 快手 Cookie，用于作为快手轮询的初始访问态；未配置时也能工作
POLLING_KUAISHOU_COOKIE=

# ====== 服务端原生弹幕采集（v1.10.0，默认全关） ======
# 逗号分隔平台白名单：huya,bilibili,douyu,douyin；留空 = 全关（走扩展推送路径，行为不变）
# 弹幕采集异常绝不影响录制主流程；分平台灰度：建议按 huya → bilibili,douyu → douyin 顺序开启
DANMAKU_NATIVE_PLATFORMS=
# 抖音 ttwid（douyin 平台需要；缺省使用内置值但有时效风险，失效请重新抓取）
DOUYIN_TTWID=
# B站 cookie（可选；getDanmuInfo 遇 -352 风控或大房间风控更严时补充）
# BILIBILI_DANMAKU_COOKIE=

# 快手轮询 Checker（HTTP API 直连，无需 Browserless）
KUAISHOU_CHECKER_ENABLED=true
# KUAISHOU_API_TIMEOUT_MS=15000

# 远程浏览器 / Browserless 配置
# connectOverCDP 使用 Browserless CDP endpoint（回放 m3u8 提取使用）
# REMOTE_BROWSER_WS_ENDPOINT=ws://127.0.0.1:3000/chromium?token=change-me-browserless-token
BROWSERLESS_TOKEN=change-me-browserless-token
BROWSERLESS_CONCURRENT=1
BROWSERLESS_QUEUED=5
BROWSERLESS_TIMEOUT_MS=60000

# NAS 备份配置（可选；投稿后处理 after_upload=backup 时使用）
# Docker 部署若已通过 volume 持久化录制目录，可不配置；未配置时会跳过 NAS 备份。
# NAS_HOST=192.168.1.100
# NAS_USER=username
# NAS_BACKUP_DIR=/volume1/video_backups

# ====== Docker Compose 相关（仅生产 / cron / browserless 场景需要） ======
# 以下变量在 docker-compose.prod.yml 中被引用。标注【生产必填】的没有默认值，
# 缺失会导致 compose 直接报错；其余有安全的通用默认值，但生产环境应显式填写真实值。
#
# 【生产必填】镜像版本号（禁止 latest）
# APP_VERSION=v1.8.2
# 【生产必填】外部 docker 网络名（反向代理 / 面板集成用，需已存在）
# EXTERNAL_NETWORK_NAME=
# 主服务宿主机端口映射
HOST_PORT=11123
# yt-dlp 临时目录宿主机路径（建议挂 SSD）
# YTDLP_TEMP_HOST_DIR=/path/to/tmp/yt_dlp_cache
# 弹幕归档宿主机路径
# DANMAKU_ARCHIVE_HOST_DIR=/path/to/danmaku_archive
# 数据库备份产物宿主机路径（不设则回退仓库 ../backups，与数据库同盘；
# 若宿主机另有备份/快照计划覆盖的目录，建议指向那里）
# DB_BACKUP_HOST_DIR=/path/to/backups
# 生产资源限制
# APP_CPU_LIMIT=2
# APP_MEM_LIMIT=2G
# 时区
# TZ=Asia/Shanghai

# cron 服务（replay_cron）
CRON_API_TOKEN=
REPLAY_CRON_EXPR=0 3 * * *
REPLAY_CRON_ENABLED=false
REPLAY_PRINCIPAL_ID=
REPLAY_CRON_COUNT=1
SYNC_CRON_EXPR=0 4 * * *
SYNC_CRON_ENABLED=false
SUPABASE_URL=
REMOTE_TABLE=test_records
# 数据库定时备份：与上面两个任务不同，这里默认建议开启（备份静默缺失过一次代价），
# 关掉它只需改成 false
BACKUP_CRON_ENABLED=true
BACKUP_CRON_EXPR=30 2 * * *
BACKUP_RETENTION_DAYS=7
# 容器内备份目录，需与 docker-compose.cron.yml 的挂载点保持一致，一般不用改
# BACKUP_OUTPUT_DIR=/data/db_backups
REDIS_PUBLISH_CHANNEL=task:completed

# AI 配置（用于自动生成 Release Note）
AI_API_KEY=sk-
# 模型名称（LiteLLM 格式: provider/model_name）
# 示例: deepseek/deepseek-v4-flash, openai/gpt-4o, gemini/gemini-2.5-flash
AI_MODEL=deepseek/deepseek-v4-flash
# API 端点
AI_API_BASE=https://api.deepseek.com

# AI 弹幕分析（ADR-017 / v1.13.0，与上面 Release Note 用的 AI_* 无关）
# LiteLLM API Key：只走环境变量，绝不入库/进前端/落日志；留空则分析自动降级为纯统计报告
AI_ANALYSIS_API_KEY=
# 备用模型链（逗号分隔，留空用内置默认 glm-5.3-flash,qwen3.7-flash）
# AI_ANALYSIS_FALLBACK_MODELS=
