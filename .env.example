# express 配置
NODE_ENV=production
PORT=1123
APP_DATA_DIR=/data
VIDEO_DOWNLOAD_DIR=/data/video_downloads
DANMAKU_OUTPUT_DIR=/data/danmaku_output

# 登录鉴权
ADMIN_USERNAME=admin
AUTH_TOKEN_TTL_HOURS=24
AUTH_COOKIE_NAME=auth_token
AUTH_COOKIE_SECURE=false
LOGIN_RATE_LIMIT=5
LOGIN_LOCKOUT_MIN=5
AUTH_ENABLED=true

# PostgreSQL 数据库配置
# Docker 推荐使用 DATABASE_URL；旧部署可继续使用下方拆分变量
# DATABASE_URL=postgresql://postgres:password@postgres:5432/live_recorder
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=live_recorder
DB_USER=postgres
DB_PASSWORD=

# Redis 配置（用于缓存直播间数据、录制任务锁）
# Docker 推荐使用 REDIS_URL；旧部署可继续使用下方拆分变量
# REDIS_URL=redis://default:password@redis:6379/1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USER=default
REDIS_DB=1

# biliup 工作目录（Docker 默认 /data/biliup）
BILIUP_WORK_DIR=/data/biliup

# 消息通知（可选；未配置则静默跳过）
MESSAGE_FEISHU_WEBHOOK=
MESSAGE_GOTIFY_SERVER=
MESSAGE_GOTIFY_TOKEN=
MESSAGE_GOTIFY_PRIORITY=5

# 轮询配置（可选）
# 抖音 Cookie，用于提高 Web API 请求成功率；未配置时也能工作
POLLING_DOUYIN_COOKIE=
# 快手 Cookie，用于作为快手轮询的初始访问态；未配置时也能工作
POLLING_KUAISHOU_COOKIE=

# 快手轮询 Checker（可选；默认远程浏览器模式，需要 Browserless/Chromium）
# 模式切换：默认 remote-browser，设为 api 则使用 HTTP API 直连（无需 Browserless）
# KUAISHOU_CHECKER_MODE=remote-browser
KUAISHOU_CHECKER_ENABLED=true

# 远程浏览器模式配置
# connectOverCDP 使用 Browserless CDP endpoint
# REMOTE_BROWSER_WS_ENDPOINT=ws://127.0.0.1:3000/chromium?token=change-me-browserless-token

# API 直连模式配置（KUAISHOU_CHECKER_MODE=api 时生效）
# KUAISHOU_API_TIMEOUT_MS=15000

# NAS 备份配置（可选；投稿后处理 after_upload=backup 时使用）
# Docker 部署若已通过 volume 持久化录制目录，可不配置；未配置时会跳过 NAS 备份。
# NAS_HOST=192.168.1.100
# NAS_USER=username
# NAS_BACKUP_DIR=/volume1/video_backups

# AI 配置（用于自动生成 Release Note）
AI_API_KEY=sk-
# 模型名称（LiteLLM 格式: provider/model_name）
# 示例: deepseek/deepseek-v4-flash, openai/gpt-4o, gemini/gemini-2.5-flash
AI_MODEL=deepseek/deepseek-v4-flash
# API 端点
AI_API_BASE=https://api.deepseek.com
