# express 配置
NODE_ENV=production
PORT=1123
APP_DATA_DIR=/data
VIDEO_DOWNLOAD_DIR=/data/video_downloads
REPLAY_WORK_DIR=/data/replay
# yt-dlp 回放下载临时目录；Docker 生产可挂载 SSD 到 /tmp/yt_dlp_cache
YTDLP_TEMP_DIR=/tmp/yt_dlp_cache
# 弹幕归档目录（file-manage 保护，不可自动清理）
DANMAKU_ARCHIVE_DIR=/data/danmaku_archive

# 登录鉴权
ADMIN_USERNAME=admin
AUTH_TOKEN_TTL_HOURS=24
AUTH_COOKIE_NAME=auth_token
AUTH_COOKIE_SECURE=false
LOGIN_RATE_LIMIT=5
LOGIN_LOCKOUT_MIN=5
AUTH_ENABLED=true

# PostgreSQL 数据库配置
# Docker 推荐使用 DATABASE_URL；旧部署可继续使用下方拆分变量
# DATABASE_URL=postgresql://postgres:password@postgres:5432/live_recorder
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=live_recorder
DB_USER=postgres
DB_PASSWORD=

# Redis 配置（用于缓存直播间数据、录制任务锁）
# Docker 推荐使用 REDIS_URL；旧部署可继续使用下方拆分变量
# REDIS_URL=redis://default:password@redis:6379/1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USER=default
REDIS_DB=1

# biliup 工作目录（Docker 默认 /data/biliup）
BILIUP_WORK_DIR=/data/biliup

# 消息通知（可选；未配置则静默跳过）
MESSAGE_ENABLED=false
MESSAGE_FEISHU_WEBHOOK=
MESSAGE_GOTIFY_SERVER=
MESSAGE_GOTIFY_TOKEN=
MESSAGE_GOTIFY_PRIORITY=5

# 轮询配置（可选）
# 抖音 Cookie，用于提高 Web API 请求成功率；未配置时也能工作
POLLING_DOUYIN_COOKIE=
# 快手 Cookie，用于作为快手轮询的初始访问态；未配置时也能工作
POLLING_KUAISHOU_COOKIE=

# 快手轮询 Checker（HTTP API 直连，无需 Browserless）
KUAISHOU_CHECKER_ENABLED=true
# KUAISHOU_API_TIMEOUT_MS=15000

# 远程浏览器 / Browserless 配置
# connectOverCDP 使用 Browserless CDP endpoint（回放 m3u8 提取使用）
# REMOTE_BROWSER_WS_ENDPOINT=ws://127.0.0.1:3000/chromium?token=change-me-browserless-token
BROWSERLESS_TOKEN=change-me-browserless-token
BROWSERLESS_CONCURRENT=1
BROWSERLESS_QUEUED=5
BROWSERLESS_TIMEOUT_MS=60000

# NAS 备份配置（可选；投稿后处理 after_upload=backup 时使用）
# Docker 部署若已通过 volume 持久化录制目录，可不配置；未配置时会跳过 NAS 备份。
# NAS_HOST=192.168.1.100
# NAS_USER=username
# NAS_BACKUP_DIR=/volume1/video_backups

# ====== Docker Compose 相关（仅生产 / cron / browserless 场景需要） ======
# 以下变量在 docker-compose.prod.yml 中被引用。标注【生产必填】的没有默认值，
# 缺失会导致 compose 直接报错；其余有安全的通用默认值，但生产环境应显式填写真实值。
#
# 【生产必填】镜像版本号（禁止 latest）
# APP_VERSION=v1.8.2
# 【生产必填】外部 docker 网络名（反向代理 / 面板集成用，需已存在）
# EXTERNAL_NETWORK_NAME=
# 主服务宿主机端口映射
HOST_PORT=11123
# yt-dlp 临时目录宿主机路径（建议挂 SSD）
# YTDLP_TEMP_HOST_DIR=/path/to/tmp/yt_dlp_cache
# 弹幕归档宿主机路径
# DANMAKU_ARCHIVE_HOST_DIR=/path/to/danmaku_archive
# 生产资源限制
# APP_CPU_LIMIT=2
# APP_MEM_LIMIT=2G
# 时区
# TZ=Asia/Shanghai

# cron 服务（replay_cron）
CRON_API_TOKEN=
REPLAY_CRON_EXPR=0 3 * * *
REPLAY_CRON_ENABLED=false
REPLAY_PRINCIPAL_ID=
REPLAY_CRON_COUNT=1
SYNC_CRON_EXPR=0 4 * * *
SYNC_CRON_ENABLED=false
SUPABASE_URL=
REMOTE_TABLE=test_records
REDIS_PUBLISH_CHANNEL=task:completed

# AI 配置（用于自动生成 Release Note）
AI_API_KEY=sk-
# 模型名称（LiteLLM 格式: provider/model_name）
# 示例: deepseek/deepseek-v4-flash, openai/gpt-4o, gemini/gemini-2.5-flash
AI_MODEL=deepseek/deepseek-v4-flash
# API 端点
AI_API_BASE=https://api.deepseek.com
